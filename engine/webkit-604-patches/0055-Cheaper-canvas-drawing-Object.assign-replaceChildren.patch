diff --git a/Source/JavaScriptCore/runtime/ObjectConstructor.cpp b/Source/JavaScriptCore/runtime/ObjectConstructor.cpp
index afd79890..1aa20c4b 100644
--- a/Source/JavaScriptCore/runtime/ObjectConstructor.cpp
+++ b/Source/JavaScriptCore/runtime/ObjectConstructor.cpp
@@ -315,6 +315,33 @@ EncodedJSValue JSC_HOST_CALL objectConstructorAssign(ExecState* exec)
         JSObject* source = sourceValue.toObject(exec);
         RETURN_IF_EXCEPTION(scope, { });
 
+        // A plain object whose properties can all be read straight out of it
+        // (no getters, no custom or non-enumerable properties, no indexed
+        // ones, nothing that overrides property lookup) is copied from its
+        // structure, which saves building the name array and looking each
+        // property up again. Values are read first and only then assigned,
+        // since assigning can run script that changes the source.
+        Structure* sourceStructure = source->structure(vm);
+        if (sourceStructure->typeInfo().type() == FinalObjectType
+            && !sourceStructure->typeInfo().overridesGetOwnPropertySlot()
+            && !sourceStructure->hasCustomGetterSetterProperties()
+            && !hasIndexedProperties(sourceStructure->indexingType())
+            && sourceStructure->canAccessPropertiesQuicklyForEnumeration()) {
+            Vector<RefPtr<UniquedStringImpl>, 8> keys;
+            MarkedArgumentBuffer values;
+            sourceStructure->forEachOwnPropertyInOrder(vm, [&] (const PropertyMapEntry& entry) -> bool {
+                keys.append(entry.key);
+                values.append(source->getDirect(entry.offset));
+                return true;
+            });
+            for (unsigned j = 0; j < keys.size(); ++j) {
+                PutPropertySlot putPropertySlot(target, true);
+                target->putInline(exec, Identifier::fromUid(&vm, keys[j].get()), values.at(j), putPropertySlot);
+                RETURN_IF_EXCEPTION(scope, { });
+            }
+            continue;
+        }
+
         PropertyNameArray properties(exec, PropertyNameMode::StringsAndSymbols);
         source->methodTable(vm)->getOwnPropertyNames(source, exec, properties, EnumerationMode(DontEnumPropertiesMode::Include));
         RETURN_IF_EXCEPTION(scope, { });
diff --git a/Source/JavaScriptCore/runtime/Options.cpp b/Source/JavaScriptCore/runtime/Options.cpp
index 857a8af3..e16373dd 100644
--- a/Source/JavaScriptCore/runtime/Options.cpp
+++ b/Source/JavaScriptCore/runtime/Options.cpp
@@ -368,6 +368,15 @@ static void overrideDefaults()
 
 static void recomputeDependentOptions()
 {
+#if CPU(PPC)
+    // These Macs have one processor. Concurrent collection then buys no
+    // parallelism and still pays for the barriers and the mutator slices,
+    // and a concurrent compile is a second thread competing for the one
+    // core the mutator is running on.
+    Options::useConcurrentGC() = false;
+    Options::useConcurrentBarriers() = false;
+    Options::useConcurrentJIT() = false;
+#endif
 #if !defined(NDEBUG)
     Options::validateDFGExceptionHandling() = true;
 #endif
