diff --git a/Source/JavaScriptCore/runtime/StructureInlines.h b/Source/JavaScriptCore/runtime/StructureInlines.h
index c83113c4..9526dc3c 100644
--- a/Source/JavaScriptCore/runtime/StructureInlines.h
+++ b/Source/JavaScriptCore/runtime/StructureInlines.h
@@ -405,4 +405,18 @@ inline void Structure::setPropertyTable(VM& vm, PropertyTable* table)
     m_propertyTableUnsafe.setMayBeNull(vm, this, table);
 }
     
+template<typename Functor>
+inline void Structure::forEachOwnPropertyInOrder(VM& vm, const Functor& functor)
+{
+    PropertyTable* table = ensurePropertyTableIfNotEmpty(vm);
+    if (!table)
+        return;
+
+    PropertyTable::iterator end = table->end();
+    for (PropertyTable::iterator iter = table->begin(); iter != end; ++iter) {
+        if (!functor(*iter))
+            return;
+    }
+}
+
 } // namespace JSC
