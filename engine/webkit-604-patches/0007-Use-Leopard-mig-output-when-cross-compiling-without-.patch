From fd3480c00018efe1378271bd5e3edb8f026ba56c Mon Sep 17 00:00:00 2001
From: Adam Cipoletti <adam@amcreativecoach.com>
Date: Thu, 17 Sep 2026 23:57:01 -0400
Subject: [PATCH 07/44] Use Leopard mig output when cross-compiling without mig

---
 Source/WTF/wtf/PlatformMac.cmake              |   14 +-
 .../polliwog/mig/MachExceptionsServer.h       |  263 +++
 WebKitLibraries/polliwog/mig/README           |    4 +
 WebKitLibraries/polliwog/mig/mach_exc.h       |  258 +++
 WebKitLibraries/polliwog/mig/mach_excServer.c | 1471 +++++++++++++++++
 WebKitLibraries/polliwog/mig/mach_excUser.c   | 1218 ++++++++++++++
 6 files changed, 3227 insertions(+), 1 deletion(-)
 create mode 100644 WebKitLibraries/polliwog/mig/MachExceptionsServer.h
 create mode 100644 WebKitLibraries/polliwog/mig/README
 create mode 100644 WebKitLibraries/polliwog/mig/mach_exc.h
 create mode 100644 WebKitLibraries/polliwog/mig/mach_excServer.c
 create mode 100644 WebKitLibraries/polliwog/mig/mach_excUser.c

diff --git a/Source/WTF/wtf/PlatformMac.cmake b/Source/WTF/wtf/PlatformMac.cmake
index ae500293..a186536e 100644
--- a/Source/WTF/wtf/PlatformMac.cmake
+++ b/Source/WTF/wtf/PlatformMac.cmake
@@ -46,6 +46,18 @@ list(APPEND WTF_INCLUDE_DIRECTORIES
 
 file(COPY mac/MachExceptions.defs DESTINATION ${DERIVED_SOURCES_WTF_DIR})
 
+# A cross build has no mig; use the output of Leopard's mig kept in the tree.
+find_program(MIG_EXECUTABLE mig)
+if (MIG_EXECUTABLE)
+    set(WTF_MIG_COMMAND ${MIG_EXECUTABLE} -sheader MachExceptionsServer.h MachExceptions.defs)
+else ()
+    set(WTF_MIG_PREBUILT ${CMAKE_SOURCE_DIR}/WebKitLibraries/polliwog/mig)
+    set(WTF_MIG_COMMAND ${CMAKE_COMMAND} -E copy
+        ${WTF_MIG_PREBUILT}/MachExceptionsServer.h ${WTF_MIG_PREBUILT}/mach_exc.h
+        ${WTF_MIG_PREBUILT}/mach_excServer.c ${WTF_MIG_PREBUILT}/mach_excUser.c
+        ${DERIVED_SOURCES_WTF_DIR})
+endif ()
+
 add_custom_command(
     OUTPUT
         ${DERIVED_SOURCES_WTF_DIR}/MachExceptionsServer.h
@@ -54,7 +66,7 @@ add_custom_command(
         ${DERIVED_SOURCES_WTF_DIR}/mach_excUser.c
     MAIN_DEPENDENCY mac/MachExceptions.defs
     WORKING_DIRECTORY ${DERIVED_SOURCES_WTF_DIR}
-    COMMAND mig -sheader MachExceptionsServer.h MachExceptions.defs
+    COMMAND ${WTF_MIG_COMMAND}
     VERBATIM)
 list(APPEND WTF_SOURCES
     ${DERIVED_SOURCES_WTF_DIR}/mach_excServer.c
