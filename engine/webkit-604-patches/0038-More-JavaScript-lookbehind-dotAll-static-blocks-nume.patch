+// An identifier character beyond the Basic Multilingual Plane, such as the
+// mathematical letters U+1D400 and on, which UTF-16 writes as two units.
+template<typename CharType>
+static ALWAYS_INLINE bool isIdentSurrogatePair(CharType current, CharType next, bool start)
+{
+    if (!U16_IS_LEAD(current) || !U16_IS_TRAIL(next))
+        return false;
+    UChar32 character = U16_GET_SUPPLEMENTARY(current, next);
+    return start ? isNonLatin1IdentStart(character) : isNonLatin1IdentPart(character);
