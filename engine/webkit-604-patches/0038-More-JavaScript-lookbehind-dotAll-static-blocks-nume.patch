+static bool isURLLikeSpecifier(const String& specifier)
+{
+    return specifier.startsWith('/') || specifier.startsWith("./") || specifier.startsWith("../");
+}
+
+void ScriptModuleLoader::registerImportMap(const String& json, const URL& baseURL)
+{
+    RefPtr<Inspector::InspectorValue> value;
+    RefPtr<Inspector::InspectorObject> map;
+    RefPtr<Inspector::InspectorObject> imports;
+    if (!Inspector::InspectorValue::parseJSON(json, value) || !value->asObject(map) || !map->getObject(ASCIILiteral("imports"), imports))
+        return;
+
+    for (auto& entry : *imports) {
+        String address;
+        if (!entry.value->asString(address))
+            continue;
+        URL addressURL = m_document.completeURL(address, baseURL);
+        if (!addressURL.isValid())
+            continue;
+        String key = entry.key;
+        if (isURLLikeSpecifier(key))
+            key = m_document.completeURL(key, baseURL).string();
+        else {
+            URL keyURL(URL(), key);
+            if (keyURL.isValid())
+                key = keyURL.string();
+        }
+        m_importMap.append(std::make_pair(key, addressURL));
+    }
+}
+
+std::optional<URL> ScriptModuleLoader::resolveWithImportMap(const String& normalizedSpecifier) const
+{
+    // An exact match, else the longest key ending in "/" that begins it.
+    const std::pair<String, URL>* bestPrefix = nullptr;
+    for (auto& entry : m_importMap) {
+        if (entry.first == normalizedSpecifier)
+            return entry.second;
+        if (entry.first.endsWith('/') && normalizedSpecifier.startsWith(entry.first)
+            && (!bestPrefix || entry.first.length() > bestPrefix->first.length()))
+            bestPrefix = &entry;
+    }
+    if (!bestPrefix)
+        return std::nullopt;
+    URL result(bestPrefix->second, normalizedSpecifier.substring(bestPrefix->first.length()));
+    if (!result.isValid())
+        return std::nullopt;
+    return result;
+}
+
 static Expected<URL, ASCIILiteral> resolveModuleSpecifier(Document& document, const String& specifier, const URL& baseURL)
 {
     // https://html.spec.whatwg.org/multipage/webappapis.html#resolve-a-module-specifier
 
     URL absoluteURL(URL(), specifier);
+
+    if (auto* moduleLoader = document.moduleLoader()) {
+        String normalized = specifier;
+        if (absoluteURL.isValid())
+            normalized = absoluteURL.string();
+        else if (isURLLikeSpecifier(specifier))
+            normalized = document.completeURL(specifier, baseURL).string();
+        if (auto mapped = moduleLoader->resolveWithImportMap(normalized))
+            return mapped.value();
+    }
+
     if (absoluteURL.isValid())
         return absoluteURL;
 
