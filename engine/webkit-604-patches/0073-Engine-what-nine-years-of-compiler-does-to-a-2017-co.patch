diff --git a/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm b/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
index 5bea8280..15bfd4fe 100644
--- a/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
+++ b/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
@@ -31,6 +31,7 @@
 #import "CFNetworkSPI.h"
 #import "HTTPParsers.h"
 #import "WebCoreURLResponse.h"
+#import <dlfcn.h>
 #import <Foundation/Foundation.h>
 #import <limits>
 #import <wtf/AutodrainedPool.h>
@@ -84,6 +85,24 @@ void ResourceResponse::disableLazyInitialization()
     lazyInit(AllFields);
 }
 
+// 10.6 and later declare this key; the 10.5 SDK marks it as 10.6-and-later,
+// which makes it unavailable rather than absent - GCC 6 let it through and
+// GCC 14 refuses it. Looked up by name at runtime, falling back to the
+// string it is defined as, so this works either way.
+static CFStringRef sslPeerTrustKey()
+{
+    static CFStringRef key = 0;
+    static bool looked = false;
+    if (!looked) {
+        looked = true;
+        if (void** pointer = static_cast<void**>(dlsym(RTLD_DEFAULT, "kCFStreamPropertySSLPeerTrust")))
+            key = static_cast<CFStringRef>(*pointer);
+        if (!key)
+            key = CFSTR("kCFStreamPropertySSLPeerTrust");
+    }
+    return key;
+}
+
 CertificateInfo ResourceResponse::platformCertificateInfo() const
 {
 #if USE(CFURLCONNECTION)
@@ -101,7 +120,7 @@ CertificateInfo ResourceResponse::platformCertificateInfo() const
     if (!context)
         return { };
 
-    auto trustValue = CFDictionaryGetValue(context, kCFStreamPropertySSLPeerTrust);
+    auto trustValue = CFDictionaryGetValue(context, sslPeerTrustKey());
     if (!trustValue)
         return { };
     ASSERT(CFGetTypeID(trustValue) == SecTrustGetTypeID());
