diff --git a/Source/WebKitLegacy/PlatformMac.cmake b/Source/WebKitLegacy/PlatformMac.cmake
index 3becb741..e30c54c0 100644
--- a/Source/WebKitLegacy/PlatformMac.cmake
+++ b/Source/WebKitLegacy/PlatformMac.cmake
@@ -522,3 +522,14 @@ WEBKIT_CREATE_FORWARDING_HEADERS(WebKit DIRECTORIES ${FORWARDING_HEADERS_DIR}/We
 set(WebKit_OUTPUT_NAME WebKitLegacy)
 
 set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -compatibility_version 1 -current_version ${WEBKIT_MAC_VERSION}")
+
+# GCC 14.2 crashes compiling this one file - an internal compiler error in
+# its partial redundancy pass, tree-ssa-pre.cc:2609. The pass is turned off
+# for this file alone rather than for the whole build, so that a measurement
+# of this compiler against the old one is not quietly measuring one fewer
+# optimization everywhere.
+if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 14)
+    # -fno-tree-pre alone does not avoid it, so this file is built at -O1,
+    # where the pass does not run at all. One file out of three thousand.
+    set_source_files_properties(mac/WebView/WebHTMLView.mm PROPERTIES COMPILE_FLAGS "-O1 -fno-tree-pre")
+endif ()
