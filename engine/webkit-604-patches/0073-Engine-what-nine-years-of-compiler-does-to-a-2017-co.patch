 Source/WebCore/CMakeLists.txt                 |  7 ++++++-
 .../WebCore/bindings/js/JSImageDataCustom.cpp |  3 +++
 .../audio/mac/AudioHardwareListenerMac.h      |  1 +
 .../WebCore/platform/network/cf/DNSCFNet.cpp  | 18 +++++++++++-----
 .../platform/network/cf/ProxyServerCFNet.cpp  | 18 +++++++++++-----
 .../cf/SocketStreamHandleImplCFNet.cpp        | 18 +++++++++++-----
 .../network/cocoa/ResourceResponseCocoa.mm    | 21 ++++++++++++++++++-
 Source/WebCore/svg/SVGLengthContext.cpp       |  4 ++++
 Source/WebKitLegacy/CMakeLists.txt            |  4 ++--
 Source/WebKitLegacy/PlatformMac.cmake         | 11 ++++++++++
 .../mac/DOM/WebDOMOperationsPrivate.h         |  6 ++++++
 .../WebKitLegacy/mac/WebView/WebViewPrivate.h |  6 ++++++
 12 files changed, 98 insertions(+), 19 deletions(-)

diff --git a/Source/WebCore/CMakeLists.txt b/Source/WebCore/CMakeLists.txt
index 9a4be46f..ae1081eb 100644
--- a/Source/WebCore/CMakeLists.txt
+++ b/Source/WebCore/CMakeLists.txt
@@ -3955,7 +3955,12 @@ endif ()
 WEBKIT_FRAMEWORK(WebCore)
 
 if (APPLE)
-    set_target_properties(WebCore PROPERTIES LINK_FLAGS "-lobjc -sub_library libobjc -umbrella WebKit -allowable_client WebCoreTestSupport -allowable_client WebKit2 -allowable_client WebKitLegacy")
+    # Each of these is a linker option with an argument, and the two have to
+    # arrive at the linker together. GCC 6's driver passed them through as
+    # written; GCC 14's hands the argument on as if it were a file to link,
+    # and the build stops on "file not found: WebKit". Spelling them -Wl,
+    # with commas says what was meant either way.
+    set_target_properties(WebCore PROPERTIES LINK_FLAGS "-lobjc -Wl,-sub_library,libobjc -Wl,-umbrella,WebKit -Wl,-allowable_client,WebCoreTestSupport -Wl,-allowable_client,WebKit2 -Wl,-allowable_client,WebKitLegacy")
 endif ()
 
 if (WIN32)
