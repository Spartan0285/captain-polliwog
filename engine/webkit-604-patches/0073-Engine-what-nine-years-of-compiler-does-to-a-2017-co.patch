diff --git a/Source/WebCore/platform/network/cf/DNSCFNet.cpp b/Source/WebCore/platform/network/cf/DNSCFNet.cpp
index 155b7d99..12e7dd85 100644
--- a/Source/WebCore/platform/network/cf/DNSCFNet.cpp
+++ b/Source/WebCore/platform/network/cf/DNSCFNet.cpp
@@ -50,17 +50,25 @@
 #include <wtf/SoftLinking.h>
 
 SOFT_LINK_FRAMEWORK_IN_UMBRELLA(CoreServices, CFNetwork)
-#pragma GCC diagnostic push
-#pragma GCC diagnostic ignored "-Wredundant-decls"
-SOFT_LINK(CFNetwork, CFNetworkCopySystemProxySettings, CFDictionaryRef, (), ())
-#pragma GCC diagnostic pop
+// The 10.5 SDK declares this one as 10.6-and-later, which makes it
+// unavailable rather than merely absent. GCC 6 let a call through anyway;
+// GCC 14 refuses it, and a soft link cannot help because the name it
+// defines is the name the SDK has already spoken for. So it is looked up
+// here under a name of its own. The symbol is still the real one at
+// runtime - this only keeps the compiler away from the SDK's declaration.
+static CFDictionaryRef copySystemProxySettings()
+{
+    typedef CFDictionaryRef (*CopySystemProxySettingsFunction)(void);
+    static CopySystemProxySettingsFunction function = reinterpret_cast<CopySystemProxySettingsFunction>(dlsym(CFNetworkLibrary(), "CFNetworkCopySystemProxySettings"));
+    return function ? function() : 0;
+}
 #endif
 
 namespace WebCore {
 
 void DNSResolveQueue::updateIsUsingProxy()
 {
-    RetainPtr<CFDictionaryRef> proxySettings = adoptCF(CFNetworkCopySystemProxySettings());
+    RetainPtr<CFDictionaryRef> proxySettings = adoptCF(copySystemProxySettings());
     if (!proxySettings) {
         m_isUsingProxy = false;
         return;
