From f30fa028de15bebf95cf4d9424bd1558b0cb774d Mon Sep 17 00:00:00 2001
From: Adam Cipoletti <adam@amcreativecoach.com>
Date: Fri, 18 Sep 2026 10:12:54 -0400
Subject: [PATCH 26/29] Caret movement: drop Apple ICU's !!RINoChain, and never
 keep a null iterator

Upstream ICU rejects the caret rule set because of the Apple-only
!!RINoChain option, and the failure left a null break iterator: typing
into a password field (whose bullets are not ASCII) crashed.
---
 Source/WTF/wtf/text/icu/TextBreakIteratorICU.h | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Source/WTF/wtf/text/icu/TextBreakIteratorICU.h b/Source/WTF/wtf/text/icu/TextBreakIteratorICU.h
index 308e40e2..0311843b 100644
--- a/Source/WTF/wtf/text/icu/TextBreakIteratorICU.h
+++ b/Source/WTF/wtf/text/icu/TextBreakIteratorICU.h
@@ -82,7 +82,8 @@ static String caretRules()
         "$EmojiForMods = [\\u261D \\u26F9 \\u270A-\\u270D \\U0001F385 \\U0001F3C3-\\U0001F3C4 \\U0001F3CA \\U0001F3CB \\U0001F442-\\U0001F443 \\U0001F446-\\U0001F450 \\U0001F466-\\U0001F478 \\U0001F47C \\U0001F481-\\U0001F483 \\U0001F485-\\U0001F487 \\U0001F4AA \\U0001F575 \\U0001F590 \\U0001F595 \\U0001F596 \\U0001F645-\\U0001F647 \\U0001F64B-\\U0001F64F \\U0001F6A3 \\U0001F6B4-\\U0001F6B6 \\U0001F6C0 \\U0001F918 \\U0001F3C2 \\U0001F3C7 \\U0001F3CC \\U0001F574 \\U0001F57A \\U0001F6CC \\U0001F919-\\U0001F91E \\U0001F926 \\U0001F930 \\U0001F933-\\U0001F939 \\U0001F93C-\\U0001F93E] ;" // Emoji that take Fitzpatrick modifiers
         "$EmojiMods = [\\U0001F3FB-\\U0001F3FF];" // Fitzpatrick modifiers
         "!!chain;"
-        "!!RINoChain;"
+        // "!!RINoChain;" is an option only Apple's ICU understands; upstream
+        // ICU (which Captain Polliwog bundles) rejects the whole rule set.
         "!!forward;"
         "$CR $LF;"
         "$L ($L | $V | $LV | $LVT);"
@@ -194,6 +195,12 @@ public:
             static NeverDestroyed<StringView::UpconvertedCharacters> upconvertedRules = StringView(caretRules).upconvertedCharacters();
             UParseError parseError;
             m_iterator = ubrk_openRules(upconvertedRules.get(), caretRules.get().length(), text, textLength, &parseError, &status);
+            // If this ICU cannot compile the rules, use its standard character
+            // iterator rather than leave a null one to crash on.
+            if (!m_iterator) {
+                status = U_ZERO_ERROR;
+                m_iterator = ubrk_open(UBRK_CHARACTER, locale, text, textLength, &status);
+            }
         } else
 #endif
             m_iterator = ubrk_open(type, locale, text, textLength, &status);
