diff --git a/Source/WebKitLegacy/PlatformMac.cmake b/Source/WebKitLegacy/PlatformMac.cmake
index d95272c4..61f0efd0 100644
--- a/Source/WebKitLegacy/PlatformMac.cmake
+++ b/Source/WebKitLegacy/PlatformMac.cmake
@@ -410,6 +410,26 @@ file(COPY
     mac/Plugins/Hosted/WebKitPluginHostTypes.h
 DESTINATION ${DERIVED_SOURCES_WEBKITLEGACY_DIR})
 
+# A cross build has no mig; use the output of Leopard's mig kept in the tree.
+find_program(MIG_EXECUTABLE mig)
+set(WEBKITLEGACY_MIG_PREBUILT ${CMAKE_SOURCE_DIR}/WebKitLibraries/polliwog/mig/WebKitLegacy)
+if (MIG_EXECUTABLE)
+    set(WEBKITLEGACY_MIG_AGENT ${MIG_EXECUTABLE} -I.. WebKitPluginAgent.defs WebKitPluginAgentReply.defs WebKitPluginHost.defs)
+    set(WEBKITLEGACY_MIG_CLIENT ${MIG_EXECUTABLE} -I.. -sheader WebKitPluginClientServer.h WebKitPluginClient.defs)
+else ()
+    set(WEBKITLEGACY_MIG_AGENT ${CMAKE_COMMAND} -E copy
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgent.h ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgentReply.h
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginHost.h
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgentReplyServer.c ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgentReplyUser.c
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgentServer.c ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginAgentUser.c
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginHostServer.c ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginHostUser.c
+        ${DERIVED_SOURCES_WEBKITLEGACY_DIR})
+    set(WEBKITLEGACY_MIG_CLIENT ${CMAKE_COMMAND} -E copy
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginClient.h ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginClientServer.h
+        ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginClientServer.c ${WEBKITLEGACY_MIG_PREBUILT}/WebKitPluginClientUser.c
+        ${DERIVED_SOURCES_WEBKITLEGACY_DIR})
+endif ()
+
 add_custom_command(
     OUTPUT
         ${DERIVED_SOURCES_WEBKITLEGACY_DIR}/WebKitPluginAgentReplyServer.c
@@ -420,7 +440,7 @@ add_custom_command(
         ${DERIVED_SOURCES_WEBKITLEGACY_DIR}/WebKitPluginHostUser.c
     MAIN_DEPENDENCY mac/Plugins/Hosted/WebKitPluginAgent.defs
     WORKING_DIRECTORY ${DERIVED_SOURCES_WEBKITLEGACY_DIR}
-    COMMAND mig -I.. WebKitPluginAgent.defs WebKitPluginAgentReply.defs WebKitPluginHost.defs
+    COMMAND ${WEBKITLEGACY_MIG_AGENT}
     VERBATIM)
 add_custom_command(
     OUTPUT
@@ -428,7 +448,7 @@ add_custom_command(
         ${DERIVED_SOURCES_WEBKITLEGACY_DIR}/WebKitPluginClientUser.c
     MAIN_DEPENDENCY mac/Plugins/Hosted/WebKitPluginAgent.defs
     WORKING_DIRECTORY ${DERIVED_SOURCES_WEBKITLEGACY_DIR}
-    COMMAND mig -I.. -sheader WebKitPluginClientServer.h WebKitPluginClient.defs
+    COMMAND ${WEBKITLEGACY_MIG_CLIENT}
     VERBATIM)
 list(APPEND WebKit_SOURCES
     ${DERIVED_SOURCES_WEBKITLEGACY_DIR}/WebKitPluginAgentUser.c
diff --git a/WebKitLibraries/polliwog/mig/README b/WebKitLibraries/polliwog/mig/README
index 1df6e0bb..9a2d779e 100644
--- a/WebKitLibraries/polliwog/mig/README
+++ b/WebKitLibraries/polliwog/mig/README
@@ -2,3 +2,7 @@ Output of Leopard's own mig (Xcode 3.1.4, Mac OS X 10.5), run on an iBook G4 as
   mig -arch ppc -sheader MachExceptionsServer.h MachExceptions.defs
 for Source/WTF/wtf/mac/MachExceptions.defs. The Linux cross toolchain has no
 mig, so WTF's CMake copies these files when mig is not found.
+
+WebKitLegacy/: the plug-in host interfaces in
+Source/WebKitLegacy/mac/Plugins/Hosted, generated the same way (with -I..
+pointing at a WebKit/ directory holding the .defs and WebKitPluginHostTypes.h).
