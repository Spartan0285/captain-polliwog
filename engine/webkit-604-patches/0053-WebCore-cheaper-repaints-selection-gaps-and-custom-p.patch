diff --git a/Source/WebCore/platform/ScrollView.h b/Source/WebCore/platform/ScrollView.h
index 9622188e..03b1f749 100644
--- a/Source/WebCore/platform/ScrollView.h
+++ b/Source/WebCore/platform/ScrollView.h
@@ -60,6 +60,8 @@ class HostWindow;
 class LegacyTileCache;
 class Scrollbar;
 
+class RunLoopObserver;
+
 class ScrollView : public Widget, public ScrollableArea {
 public:
     virtual ~ScrollView();
@@ -511,6 +513,17 @@ private:
     bool platformScroll(ScrollDirection, ScrollGranularity);
     void platformSetScrollbarsSuppressed(bool repaintOnUnsuppress);
     void platformRepaintContentRectangle(const IntRect&);
+#if PLATFORM(MAC)
+public:
+    // Repaints are collected and handed to AppKit once per run loop pass:
+    // -[NSView setNeedsDisplayInRect:] walks up the view tree and is guarded
+    // against Objective-C exceptions, which a page invalidating hundreds of
+    // small rectangles during layout pays for every time.
+    WEBCORE_EXPORT void flushPendingRepaints();
+private:
+    Vector<IntRect> m_pendingRepaintRects;
+    std::unique_ptr<RunLoopObserver> m_pendingRepaintObserver;
+#endif
     bool platformIsOffscreen() const;
     void platformSetScrollbarOverlayStyle(ScrollbarOverlayStyle);
    
diff --git a/Source/WebCore/platform/mac/ScrollViewMac.mm b/Source/WebCore/platform/mac/ScrollViewMac.mm
index 5381e2ab..ab1cd7b3 100644
--- a/Source/WebCore/platform/mac/ScrollViewMac.mm
+++ b/Source/WebCore/platform/mac/ScrollViewMac.mm
@@ -26,6 +26,8 @@
 #import "config.h"
 #import "ScrollView.h"
 
+#import "RunLoopObserver.h"
+
 #import "FloatRect.h"
 #import "FloatSize.h"
 #import "IntRect.h"
@@ -224,12 +226,45 @@ bool ScrollView::platformScroll(ScrollDirection, ScrollGranularity)
     return false;
 }
 
+// Before AppKit's own display pass, which runs at a much higher order.
+static const CFIndex repaintFlushRunLoopOrder = 0;
+
 void ScrollView::platformRepaintContentRectangle(const IntRect& rect)
 {
-    BEGIN_BLOCK_OBJC_EXCEPTIONS;
-    NSView *view = documentView();
-    [view setNeedsDisplayInRect:rect];
+    m_pendingRepaintRects.append(rect);
+    if (!m_pendingRepaintObserver) {
+        m_pendingRepaintObserver = std::make_unique<RunLoopObserver>(repaintFlushRunLoopOrder, [this] {
+            flushPendingRepaints();
+        });
+    }
+    if (!m_pendingRepaintObserver->isScheduled())
+        m_pendingRepaintObserver->schedule(CFRunLoopGetCurrent());
+}
 
+void ScrollView::flushPendingRepaints()
+{
+    if (m_pendingRepaintRects.isEmpty())
+        return;
+    Vector<IntRect> rects = WTFMove(m_pendingRepaintRects);
+
+    BEGIN_BLOCK_OBJC_EXCEPTIONS;
+    if (NSView *view = documentView()) {
+        // One rectangle covering them all, unless that would repaint much
+        // more than the rectangles themselves do.
+        IntRect bounds = rects[0];
+        unsigned area = 0;
+        for (auto& rect : rects) {
+            bounds.unite(rect);
+            area += rect.width() * rect.height();
+        }
+        unsigned boundsArea = bounds.width() * bounds.height();
+        if (rects.size() > 32 || boundsArea <= area + area / 2)
+            [view setNeedsDisplayInRect:bounds];
+        else {
+            for (auto& rect : rects)
+                [view setNeedsDisplayInRect:rect];
+        }
+    }
     END_BLOCK_OBJC_EXCEPTIONS;
 }
 
