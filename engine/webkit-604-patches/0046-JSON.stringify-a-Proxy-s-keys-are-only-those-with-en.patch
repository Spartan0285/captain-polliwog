From 79f59bc8dc697481bf3dc4ea690b230e09b22334 Mon Sep 17 00:00:00 2001
From: Captain Polliwog build <build@captainpolliwog.invalid>
Date: Sat, 19 Sep 2026 08:15:31 -0400
Subject: [PATCH 46/46] JSON.stringify: a Proxy's keys are only those with
 enumerable own properties

JSON took every key a Proxy's ownKeys trap listed, but EnumerableOwnPropertyNames
keeps only keys the proxy reports as enumerable own properties.
Chart.js's option resolvers list every default key and describe only what
was set, so serializing one walked the whole defaults tree through fresh
proxies without end: Speedometer 3.1's Charts-chartjs suite ran for many
minutes and grew the browser past a gigabyte. Also for JSON.parse's reviver.
---
 Source/JavaScriptCore/runtime/JSONObject.cpp | 25 ++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/Source/JavaScriptCore/runtime/JSONObject.cpp b/Source/JavaScriptCore/runtime/JSONObject.cpp
index e23ac812..4cb9d5c5 100644
--- a/Source/JavaScriptCore/runtime/JSONObject.cpp
+++ b/Source/JavaScriptCore/runtime/JSONObject.cpp
@@ -462,6 +462,27 @@ inline Stringifier::Holder::Holder(RootHolderTag, VM& vm, JSObject* object)
 {
 }
 
+// EnumerableOwnPropertyNames for a Proxy: its ownKeys trap may list keys it
+// has no enumerable own property for (Chart.js's option resolvers list every
+// default), and JSON must skip them; for ordinary objects getOwnPropertyNames
+// has already left out what isn't enumerable.
+static void keepEnumerableProxyKeys(ExecState* exec, JSObject* object, PropertyNameArray& names)
+{
+    VM& vm = exec->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    if (object->type() != ProxyObjectType)
+        return;
+    PropertyNameArray enumerable(exec, PropertyNameMode::Strings);
+    for (const Identifier& name : names) {
+        PropertyDescriptor descriptor;
+        bool isDefined = object->getOwnPropertyDescriptor(exec, name, descriptor);
+        RETURN_IF_EXCEPTION(scope, void());
+        if (isDefined && descriptor.enumerable())
+            enumerable.addUnchecked(name.impl());
+    }
+    names = WTFMove(enumerable);
+}
+
 bool Stringifier::Holder::appendNextProperty(Stringifier& stringifier, StringBuilder& builder)
 {
     ASSERT(m_index <= m_size);
@@ -489,6 +510,8 @@ bool Stringifier::Holder::appendNextProperty(Stringifier& stringifier, StringBui
                 PropertyNameArray objectPropertyNames(exec, PropertyNameMode::Strings);
                 m_object->methodTable()->getOwnPropertyNames(m_object.get(), exec, objectPropertyNames, EnumerationMode());
                 RETURN_IF_EXCEPTION(scope, false);
+                keepEnumerableProxyKeys(exec, m_object.get(), objectPropertyNames);
+                RETURN_IF_EXCEPTION(scope, false);
                 m_propertyNames = objectPropertyNames.releaseData();
             }
             m_size = m_propertyNames->propertyNameVector().size();
@@ -710,6 +733,8 @@ NEVER_INLINE JSValue Walker::walk(JSValue unfiltered)
                 propertyStack.append(PropertyNameArray(m_exec, PropertyNameMode::Strings));
                 object->methodTable(vm)->getOwnPropertyNames(object, m_exec, propertyStack.last(), EnumerationMode());
                 RETURN_IF_EXCEPTION(scope, { });
+                keepEnumerableProxyKeys(m_exec, object, propertyStack.last());
+                RETURN_IF_EXCEPTION(scope, { });
             }
             objectStartVisitMember:
             FALLTHROUGH;
