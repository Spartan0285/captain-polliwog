@@ -545,6 +549,9 @@ void JIT::privateCompileSlowCases()
         DEFINE_SLOWCASE_OP(op_to_string)
         DEFINE_SLOWCASE_OP(op_to_primitive)
         DEFINE_SLOWCASE_OP(op_has_indexed_property)
+#if USE(JSVALUE32_64)
