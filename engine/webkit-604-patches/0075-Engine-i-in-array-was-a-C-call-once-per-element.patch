diff --git a/Source/JavaScriptCore/jit/JITOpcodes32_64.cpp b/Source/JavaScriptCore/jit/JITOpcodes32_64.cpp
index daf82447..144ff515 100644
--- a/Source/JavaScriptCore/jit/JITOpcodes32_64.cpp
+++ b/Source/JavaScriptCore/jit/JITOpcodes32_64.cpp
@@ -1096,6 +1096,92 @@ void JIT::privateCompileHasIndexedProperty(ByValInfo* byValInfo, ReturnAddressPt
     MacroAssembler::repatchCall(CodeLocationCall(MacroAssemblerCodePtr(returnAddress)), FunctionPtr(operationHasIndexedPropertyGeneric));
 }
 
+// "i in array" is the shape op_in almost always has in this engine.
+// ArrayPrototype.js runs it once per element inside forEach, map, filter,
+// every, some, reduce and find, and op_in was a DEFINE_SLOW_OP with no
+// fast path at all - a full C++ call through slow_path_in, per element,
+// with a throw scope, to answer a question that is usually a bounds check
+// and a tag compare.
+//
+// This is deliberately narrower than emit_op_has_indexed_property: that
+// opcode is emitted by for-in and may assume an integer index, while
+// "foo" in obj is perfectly legal, so a non-int32 property goes slow. It
+// also avoids the ByValInfo patching machinery, which exists so a
+// get_by_val site can be repatched for a different array shape; here the
+// two shapes that matter are checked inline and anything else takes the
+// slow path.
+//
+// Only a hit is answered inline. A miss - out of bounds, or a hole - is
+// left to the slow path, because "absent from this object" is not the
+// same question as "absent", and the prototype chain may still have it.
+void JIT::emit_op_in(Instruction* currentInstruction)
+{
+    int dst = currentInstruction[1].u.operand;
+    int base = currentInstruction[2].u.operand;
+    int property = currentInstruction[3].u.operand;
+    ArrayProfile* profile = currentInstruction[4].u.arrayProfile;
+
+    emitLoadPayload(base, regT0);
+    emitJumpSlowCaseIfNotJSCell(base);
+
+    emitLoadTag(property, regT1);
+    addSlowCase(branch32(NotEqual, regT1, TrustedImm32(JSValue::Int32Tag)));
+    emitLoadPayload(property, regT2);
+
+    emitArrayProfilingSiteWithCell(regT0, regT1, profile);
+    and32(TrustedImm32(IndexingShapeMask), regT1);
+
+    // Three shapes are worth handling inline. Int32Shape and
+    // ContiguousShape store JSValues and share one path; DoubleShape
+    // stores raw doubles and marks a hole with NaN, so it needs its own.
+    //
+    // Doubles are not an afterthought here - they are the case that pays.
+    // An array of measurements is double-shaped, which is what a charting
+    // library plots and what the array-numeric kernel builds, and a first
+    // version of this that handled only the two JSValue shapes left every
+    // one of those on the slow path while still paying for the checks.
+    // It measured slower than no fast path at all.
+    Jump isDouble = branch32(Equal, regT1, TrustedImm32(DoubleShape));
+    {
+        Jump isContiguous = branch32(Equal, regT1, TrustedImm32(ContiguousShape));
+        addSlowCase(branch32(NotEqual, regT1, TrustedImm32(Int32Shape)));
+        isContiguous.link(this);
+    }
+
+    loadPtr(Address(regT0, JSObject::butterflyOffset()), regT3);
+    addSlowCase(branch32(AboveOrEqual, regT2, Address(regT3, Butterfly::offsetOfPublicLength())));
+    load32(BaseIndex(regT3, regT2, TimesEight, OBJECT_OFFSETOF(JSValue, u.asBits.tag)), regT1);
+    addSlowCase(branch32(Equal, regT1, TrustedImm32(JSValue::EmptyValueTag)));
+    Jump found = jump();
+
+    isDouble.link(this);
+    loadPtr(Address(regT0, JSObject::butterflyOffset()), regT3);
+    addSlowCase(branch32(AboveOrEqual, regT2, Address(regT3, Butterfly::offsetOfPublicLength())));
+    loadDouble(BaseIndex(regT3, regT2, TimesEight), fpRegT0);
+    // A hole in a double butterfly is NaN, and NaN is the one value not
+    // equal to itself. DoubleNotEqualOrUnordered takes the unordered
+    // comparison, which is what a NaN gives.
+    addSlowCase(branchDouble(DoubleNotEqualOrUnordered, fpRegT0, fpRegT0));
+
+    found.link(this);
+    move(TrustedImm32(1), regT0);
+    emitStoreBool(dst, regT0);
+}
+
+void JIT::emitSlow_op_in(Instruction* currentInstruction, Vector<SlowCaseEntry>::iterator& iter)
+{
+    linkSlowCaseIfNotJSCell(iter, currentInstruction[2].u.operand); // base is a cell
+    linkSlowCase(iter); // property is an int32
+    linkSlowCase(iter); // shape is int32, contiguous or double
+    linkSlowCase(iter); // JSValue case: index within the public length
+    linkSlowCase(iter); // JSValue case: the element is not a hole
+    linkSlowCase(iter); // double case: index within the public length
+    linkSlowCase(iter); // double case: the element is not NaN
+
+    JITSlowPathCall slowPathCall(this, currentInstruction, slow_path_in);
+    slowPathCall.call();
+}
+
 void JIT::emit_op_has_indexed_property(Instruction* currentInstruction)
 {
     int dst = currentInstruction[1].u.operand;
