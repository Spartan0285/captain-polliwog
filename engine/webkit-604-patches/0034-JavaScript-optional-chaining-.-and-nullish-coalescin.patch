 // ------------------------------ LogicalOpNode ----------------------------
 
+// ------------------------------ CoalesceNode ----------------------------------
+
+RegisterID* CoalesceNode::emitBytecode(BytecodeGenerator& generator, RegisterID* dst)
+{
+    RefPtr<RegisterID> temp = generator.tempDestination(dst);
+    Ref<Label> endLabel = generator.newLabel();
+
+    generator.emitNode(temp.get(), m_expr1);
+    // emitJumpIfFalse folds this into a single op_jneq_null.
+    generator.emitJumpIfFalse(generator.emitUnaryOp(op_eq_null, generator.newTemporary(), temp.get()), endLabel.get());
+    generator.emitNodeInTailPosition(temp.get(), m_expr2);
+    generator.emitLabel(endLabel.get());
+
+    return generator.moveToDestinationIfNeeded(dst, temp.get());
+}
+
+// ------------------------------ OptionalChainBaseNode, OptionalChainNode ----------------------------------
+
+RegisterID* OptionalChainBaseNode::emitBytecode(BytecodeGenerator& generator, RegisterID* dst)
+{
+    RegisterID* value = generator.emitNode(dst, m_expr);
+    generator.emitOptionalCheck(value);
+    return value;
+}
+
+RegisterID* OptionalChainNode::emitBytecode(BytecodeGenerator& generator, RegisterID* dst)
+{
+    RefPtr<RegisterID> finalDest = generator.finalDestination(dst);
+    generator.pushOptionalChainTarget();
+    generator.emitNode(finalDest.get(), m_expr);
+    generator.popOptionalChainTarget(finalDest.get(), m_isDelete);
+    return finalDest.get();
+}
+
+// ------------------------------ LogicalOpNode ----------------------------------
+
