+bool unicodePropertyRanges(const String& expression, UnicodePropertyRanges& ranges)
+{
+    String name = expression;
+    String value;
+    size_t equals = expression.find('=');
+    if (equals != notFound) {
+        name = expression.left(equals);
+        value = expression.substring(equals + 1);
+        // Only these take a value in ECMAScript.
+        if (name != "General_Category" && name != "gc" && name != "Script" && name != "sc"
+            && name != "Script_Extensions" && name != "scx")
+            return false;
+    }
+    if (name.isEmpty() || (equals != notFound && value.isEmpty()))
+        return false;
+
+    // ICU knows the properties, their aliases and their code points.
+    Vector<UChar> nameCharacters = name.charactersWithNullTermination();
+    Vector<UChar> valueCharacters = value.charactersWithNullTermination();
+    UErrorCode status = U_ZERO_ERROR;
+    USet* set = uset_openEmpty();
+    uset_applyPropertyAlias(set, nameCharacters.data(), name.length(), valueCharacters.data(), value.length(), &status);
+    if (U_FAILURE(status)) {
+        uset_close(set);
+        return false;
+    }
+    int32_t itemCount = uset_getItemCount(set);
+    for (int32_t i = 0; i < itemCount; ++i) {
+        UChar32 start;
+        UChar32 end;
+        if (!uset_getItem(set, i, &start, &end, nullptr, 0, &status) && U_SUCCESS(status))
+            ranges.append(std::make_pair(start, end));
+    }
+    uset_close(set);
+    return true;
+}
