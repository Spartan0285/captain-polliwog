+// The last argument a replace function gets when the pattern has named
+// groups (ES2018): each named group's capture, by name.
+static JSObject* namedCapturesObject(VM& vm, JSGlobalObject* globalObject, RegExp* regExp, const String& source, const int* ovector)
+{
+    JSObject* groups = JSFinalObject::create(vm, globalObject->nullPrototypeObjectStructure());
+    const Vector<String>& names = regExp->captureGroupNames();
+    for (unsigned i = 1; i < names.size(); ++i) {
+        if (names[i].isNull())
+            continue;
+        int start = ovector[i * 2];
+        JSValue value = start < 0 ? jsUndefined() : jsSubstring(&vm, source, start, ovector[i * 2 + 1] - start);
+        groups->putDirect(vm, Identifier::fromString(&vm, names[i]), value);
+    }
+    return groups;
+}
