+    for (auto& fieldLocation : fieldLocations) {
+        // setOffset clears lexer errors.
+        m_lexer->setOffset(fieldLocation.offset, fieldLocation.lineStartOffset);
+        m_lexer->setLineNumber(fieldLocation.line);
+        next();
+
+        JSTokenLocation location(tokenLocation());
+        JSTextPosition start = tokenStartPosition();
+        const Identifier* ident = nullptr;
+        TreeExpression privateKey = 0;
+        if (match(PRIVATENAME)) {
+            ident = m_token.m_data.ident;
+            privateKey = parsePrivateNameReference(context);
+        } else if (match(DOUBLE) || match(INTEGER))
+            ident = &m_parserArena.identifierArena().makeNumericIdentifier(const_cast<VM*>(m_vm), m_token.m_data.doubleValue);
