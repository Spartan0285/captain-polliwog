+// Logical assignment: jumps to done when the current value means no
+// assignment happens.
+static void emitLogicalAssignmentShortCircuit(BytecodeGenerator& generator, Operator oper, RegisterID* value, Label& done)
+{
+    switch (oper) {
+    case OpLogicalAndEq:
+        generator.emitJumpIfFalse(value, done);
+        break;
+    case OpLogicalOrEq:
+        generator.emitJumpIfTrue(value, done);
+        break;
+    default: {
+        ASSERT(oper == OpCoalesceEq);
+        RefPtr<RegisterID> isNullish = generator.emitUnaryOp(op_eq_null, generator.newTemporary(), value);
+        generator.emitJumpIfFalse(isNullish.get(), done);
+        break;
+    }
+    }
+}
