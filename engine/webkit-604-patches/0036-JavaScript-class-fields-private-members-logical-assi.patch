+// ------------------------------ ImportMetaNode ---------------------------------
+
+RegisterID* ImportMetaNode::emitBytecode(BytecodeGenerator& generator, RegisterID* dst)
+{
+    Variable importMeta = generator.variable(generator.propertyNames().builtinNames().importMetaPrivateName());
+    RefPtr<RegisterID> scope = generator.emitResolveScope(nullptr, importMeta);
+    RefPtr<RegisterID> function = generator.emitGetFromScope(generator.newTemporary(), scope.get(), importMeta, ThrowIfNotFound);
+    CallArguments args(generator, nullptr, 1);
+    generator.emitLoad(args.thisRegister(), jsUndefined());
+    generator.emitLoad(args.argumentRegister(0), m_moduleURL);
+    return generator.emitCall(generator.finalDestination(dst), function.get(), NoExpectedFunction, args, position(), position(), position(), DebuggableCall::No);
+}
+
+// ------------------------------ DefineFieldNode ---------------------------------
+
+RegisterID* DefineFieldNode::emitBytecode(BytecodeGenerator& generator, RegisterID* dst)
+{
+    RefPtr<RegisterID> value = generator.newTemporary();
+    if (m_assign)
+        generator.emitNode(value.get(), m_assign);
+    else
+        generator.emitLoad(value.get(), jsUndefined());
+
+    generator.emitExpressionInfo(divot(), divotStart(), divotEnd());
+    if (m_privateKey) {
+        // Not enumerable, so that spreading or copying the object leaves it.
+        RefPtr<RegisterID> key = generator.emitNode(m_privateKey);
+        generator.emitCallDefineProperty(generator.thisRegister(), key.get(), value.get(), nullptr, nullptr,
+            BytecodeGenerator::PropertyConfigurable | BytecodeGenerator::PropertyWritable, position());
+    } else if (std::optional<uint32_t> index = parseIndex(m_ident)) {
+        RefPtr<RegisterID> propertyIndex = generator.emitLoad(nullptr, jsNumber(index.value()));
+        generator.emitDirectPutByVal(generator.thisRegister(), propertyIndex.get(), value.get());
+    } else
+        generator.emitDirectPutById(generator.thisRegister(), m_ident, value.get(), PropertyNode::Unknown);
+    return generator.moveToDestinationIfNeeded(dst, value.get());
+}
