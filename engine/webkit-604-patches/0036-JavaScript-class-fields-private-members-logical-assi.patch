+// The key behind a private class member (#name), made each time a class is
+// evaluated. Not reachable from page scripts.
+EncodedJSValue JSC_HOST_CALL globalFuncCreatePrivateSymbol(ExecState* exec)
+{
+    VM& vm = exec->vm();
+    String description = asString(exec->uncheckedArgument(0))->value(exec);
+    PrivateName privateName(PrivateName::Description, description);
+    return JSValue::encode(Symbol::create(vm, privateName.uid()));
+}
+
+// import.meta for the module at the given URL: one object per module, made
+// when first asked for, with the module's url.
+EncodedJSValue JSC_HOST_CALL globalFuncImportMeta(ExecState* exec)
+{
+    VM& vm = exec->vm();
+    JSGlobalObject* globalObject = exec->lexicalGlobalObject();
+    String url = asString(exec->uncheckedArgument(0))->value(exec);
+    const Identifier& cacheName = vm.propertyNames->builtinNames().importMetaCachePrivateName();
+
+    JSValue cacheValue = globalObject->getDirect(vm, cacheName);
+    JSObject* cache;
+    if (cacheValue)
+        cache = asObject(cacheValue);
+    else {
+        cache = constructEmptyObject(exec, globalObject->nullPrototypeObjectStructure());
+        globalObject->putDirect(vm, cacheName, cache, DontEnum);
+    }
+
+    Identifier key = Identifier::fromString(&vm, url);
+    if (JSValue meta = cache->getDirect(vm, key))
+        return JSValue::encode(meta);
+    JSObject* meta = constructEmptyObject(exec, globalObject->nullPrototypeObjectStructure());
+    meta->putDirect(vm, Identifier::fromString(&vm, "url"), jsString(&vm, url));
+    cache->putDirect(vm, key, meta);
+    return JSValue::encode(meta);
+}
