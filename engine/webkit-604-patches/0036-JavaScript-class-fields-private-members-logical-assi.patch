+            ident = m_token.m_data.ident;
+        failIfFalse(ident, "Cannot parse the name of a class field");
+        if (!privateKey)
+            next();
+
+        TreeExpression initializer = 0;
+        if (consume(EQUAL)) {
+            initializer = parseAssignmentExpression(context);
+            failIfFalse(initializer, "Cannot parse the initializer of a class field");
+        }
+        JSTextPosition end = lastTokenEndPosition();
+        TreeExpression field = context.createDefineField(location, *ident, initializer, start, end, privateKey);
+        context.appendStatement(sourceElements, context.createExprStatement(location, field, start, end.line));
+    }
+    return sourceElements;
