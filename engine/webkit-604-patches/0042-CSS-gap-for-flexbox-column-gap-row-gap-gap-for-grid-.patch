+void SelectorChecker::setHasPseudoClassInUse()
+{
+    s_hasPseudoClassInUse = true;
+}
+
+bool SelectorChecker::hasPseudoClassInUse()
+{
+    return s_hasPseudoClassInUse;
+}
+
+// :has(): does any element after it, or inside it, match one of the relative
+// selectors, reading back to this element as their anchor?
+bool SelectorChecker::matchHasPseudoClass(const Element& element, const CSSSelector& selector) const
+{
+    for (const CSSSelector* relative = selector.selectorList()->first(); relative; relative = CSSSelectorList::next(relative)) {
+        CSSSelector::RelationType leading = CSSSelector::DescendantSpace;
+        bool singleCompound = true;
+        for (const CSSSelector* simple = relative; simple; simple = simple->tagHistory()) {
+            const CSSSelector* next = simple->tagHistory();
+            if (next && next->match() == CSSSelector::PseudoClass && next->pseudoClassType() == CSSSelector::PseudoClassHasScope) {
+                leading = simple->relation();
+                break;
+            }
+            if (next && simple->relation() != CSSSelector::Subselector)
+                singleCompound = false;
+        }
+
+        CheckingContext hasContext(Mode::QueryingRules);
+        hasContext.hasScope = &element;
+        auto matches = [&] (const Element& candidate) {
+            unsigned specificity = 0;
+            return match(*relative, candidate, hasContext, specificity);
+        };
+
+        if (leading == CSSSelector::DirectAdjacent || leading == CSSSelector::IndirectAdjacent) {
+            for (Element* sibling = element.nextElementSibling(); sibling; sibling = sibling->nextElementSibling()) {
+                if (matches(*sibling))
+                    return true;
+                if (!singleCompound) {
+                    for (Element* descendant = ElementTraversal::firstWithin(*sibling); descendant; descendant = ElementTraversal::next(*descendant, sibling)) {
+                        if (matches(*descendant))
+                            return true;
+                    }
+                } else if (leading == CSSSelector::DirectAdjacent)
+                    break;
+            }
+            continue;
+        }
+        if (leading == CSSSelector::Child && singleCompound) {
+            for (Element* child = ElementTraversal::firstChild(element); child; child = ElementTraversal::nextSibling(*child)) {
+                if (matches(*child))
+                    return true;
+            }
+            continue;
+        }
+        for (Element* descendant = ElementTraversal::firstWithin(element); descendant; descendant = ElementTraversal::next(*descendant, &element)) {
+            if (matches(*descendant))
+                return true;
+        }
+    }
+    return false;
+}
