diff --git a/Source/WTF/wtf/PlatformRegisters.h b/Source/WTF/wtf/PlatformRegisters.h
index 92cd789b..3420a720 100644
--- a/Source/WTF/wtf/PlatformRegisters.h
+++ b/Source/WTF/wtf/PlatformRegisters.h
@@ -57,9 +57,18 @@ typedef arm_thread_state64_t PlatformRegisters;
 #error Unknown Architecture
 #endif
 
+// The underscored field names arrived with the UNIX03 conformance work in
+// the 10.5 headers, and the 10.5 SDK still spells them the old way when the
+// deployment target is 10.4 - which it is for the G3.
+#if defined(__DARWIN_UNIX03) && __DARWIN_UNIX03
+#define WTF_MCONTEXT_THREAD_STATE(machineContext) ((machineContext)->__ss)
+#else
+#define WTF_MCONTEXT_THREAD_STATE(machineContext) ((machineContext)->ss)
+#endif
+
 inline PlatformRegisters& registersFromUContext(ucontext_t* ucontext)
 {
-    return ucontext->uc_mcontext->__ss;
+    return WTF_MCONTEXT_THREAD_STATE(ucontext->uc_mcontext);
 }
 
 #elif OS(WINDOWS)
