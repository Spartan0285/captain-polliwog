+// How far one line of wheel movement scrolls.
+//
+// Captain Polliwog: the same setting WebFrameView reads, for the frames and
+// overflow areas WebCore scrolls itself rather than handing to AppKit - so
+// that one choice in Preferences governs both and a page does not scroll at
+// two different speeds depending on what is under the pointer.
+//
+// It defaults to 12 - "Slow" in Preferences, chosen on a PowerBook G4 by
+// trying all four - where WebKit has always used Scrollbar::pixelsPerLineStep(),
+// 40. The point of the setting is that these machines have no
+// precise scrolling deltas and no momentum, so the only control anyone has
+// over how far a flick goes is this number.
+//
+// Read from the defaults, so changing it needs no rebuild:
+//   defaults write org.captainpolliwog.browser CPWheelPixelsPerLine 12
+static float wheelPixelsPerLine()
+{
+    static float step = 0;
+    if (!step) {
+        NSNumber *configured = [[NSUserDefaults standardUserDefaults]
+                                   objectForKey:@"CPWheelPixelsPerLine"];
+        step = configured ? [configured floatValue] : 12.0f;
+        if (step < 1.0f || step > 200.0f)
+            step = 12.0f;
+    }
+    return step;
+}
