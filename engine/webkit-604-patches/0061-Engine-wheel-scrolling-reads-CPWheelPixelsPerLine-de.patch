diff --git a/Source/WTF/wtf/text/ASCIIFastPath.h b/Source/WTF/wtf/text/ASCIIFastPath.h
index 0d463a7e..7a7abffb 100644
--- a/Source/WTF/wtf/text/ASCIIFastPath.h
+++ b/Source/WTF/wtf/text/ASCIIFastPath.h
@@ -30,7 +30,18 @@
 #if CPU(X86_SSE2)
 #include <emmintrin.h>
 #endif
-#if CPU(PPC) || CPU(PPC64)
+
+// Leopard WebKit's AltiVec fast paths through this file were written for the
+// G4 and G5 and gated on the architecture. The G3 is PowerPC with no vector
+// unit at all, so the gate has to be the vector unit: GCC defines
+// __ALTIVEC__ only when -maltivec is on.
+#if (CPU(PPC) || CPU(PPC64)) && defined(__ALTIVEC__)
+#define WTF_ALTIVEC_ASCII 1
+#else
+#define WTF_ALTIVEC_ASCII 0
+#endif
+
+#if WTF_ALTIVEC_ASCII
 #ifndef __VECLIBTYPES__
 #define __VECLIBTYPES__ // Hack to avoid problems with vecLibTypes.h from Accelerate framework
 #endif
@@ -80,7 +91,7 @@ template<> struct NonASCIIMask<8, UChar> {
 template<> struct NonASCIIMask<8, LChar> {
     static inline uint64_t value() { return 0x8080808080808080ULL; }
 };
-#if CPU(PPC) || CPU(PPC64)
+#if WTF_ALTIVEC_ASCII
 template<> struct NonASCIIMask<16, UChar> {
     static inline __vector UChar value() { return (__vector UChar)vec_sll(vec_splat_u16(8), vec_splat_u16(4)); }
 };
@@ -112,7 +123,7 @@ inline bool charactersAreAllASCII(const CharacterType* characters, size_t length
     const CharacterType* end = characters + length;
 
     // Prologue: align the input.
-#if CPU(PPC) || CPU(PPC64)
+#if WTF_ALTIVEC_ASCII
     register __vector unsigned int allCharBitsVec = (__vector unsigned int)vec_splat_u8(0);
 
     const size_t loopIncrementVec = 2 * (sizeof(__vector unsigned int) / sizeof(CharacterType));
@@ -135,7 +146,7 @@ inline bool charactersAreAllASCII(const CharacterType* characters, size_t length
         ++characters;
     }
 
-#if CPU(PPC) || CPU(PPC64)
+#if WTF_ALTIVEC_ASCII
     // Compare the values of SIMD vector size (128 bit).
     if (useVecs) {
         const CharacterType* vecEnd = (const CharacterType*)((uintptr_t)end & ~memoryAccessMask);
@@ -165,7 +176,7 @@ inline bool charactersAreAllASCII(const CharacterType* characters, size_t length
 
     MachineWord nonASCIIBitMask = NonASCIIMask<sizeof(MachineWord), CharacterType>::value();
 
-#if CPU(PPC) || CPU(PPC64)
+#if WTF_ALTIVEC_ASCII
     return !((allCharBits & nonASCIIBitMask) || (useVecs && anyNonASCIIVecElems<CharacterType>(allCharBitsVec)));
 #else
     return !(allCharBits & nonASCIIBitMask);
@@ -249,7 +260,7 @@ inline void copyLCharsFromUCharSource(LChar* destination, const UChar* source, s
 
     while (destination != end)
         *destination++ = static_cast<LChar>(*source++);
-#elif CPU(PPC) || CPU(PPC64)
+#elif WTF_ALTIVEC_ASCII
     const uintptr_t memoryAccessSize = 16; // Memory accesses on 16 byte (128 bit) alignment
     const uintptr_t memoryAccessMask = memoryAccessSize - 1;
 
