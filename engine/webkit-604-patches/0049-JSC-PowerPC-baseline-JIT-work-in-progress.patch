+    // There is no fcfid before the G5: the double with high word 0x43300000
+    // and low word (x ^ 0x80000000) is 2^52 + 2^31 + x.
+    void convertInt32ToDouble(RegisterID src, FPRegisterID dest)
+    {
+        ASSERT(src != addressTempRegister);
+        m_assembler.lis(tempRegister, 0x4330);
+        m_assembler.stw(tempRegister, stackPointerRegister, -8);
+        m_assembler.xoris(tempRegister, src, 0x8000);
+        m_assembler.stw(tempRegister, stackPointerRegister, -4);
+        m_assembler.lfd(dest, stackPointerRegister, -8);
+        loadDouble(TrustedImmPtr(&s_int32ToDoubleBias), fpTempRegister2);
+        m_assembler.fsub(dest, dest, fpTempRegister2);
+    }
+
+    void convertInt32ToDouble(Address src, FPRegisterID dest)
+    {
+        load32(src, dataTempRegister2);
+        convertInt32ToDouble(dataTempRegister2, dest);
+    }
+
