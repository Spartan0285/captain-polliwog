+#pragma once
+
+// The 32-bit PowerPC assembler for the baseline JIT (and, once it has
+// proven itself, the regular expression and CSS selector JITs, which still
+// use the TenFourFox-derived PPCAssembler.h without the JIT).
+//
+// Code layout, chosen so that nothing needs relocating when LinkBuffer
+// copies code into executable memory:
+//
+//  - Jumps and near calls are relative (b, bl: +-32MB). All JIT code lives in
+//    one fixed executable pool smaller than that (ExecutableAllocator.h).
+//  - A conditional jump is a two-word stanza, "bc !cond, +8; b target", which
+//    linking turns into "bc cond, target; nop" when the target is within the
+//    +-32KB reach of bc.
+//  - Calls to C code are absolute: "lis r12, hi; ori r12, r12, lo; mtctr r12;
+//    bctrl" (r12 holding the callee is also the Darwin convention for calls
+//    through a pointer).
+//  - Patchable 32-bit constants are "lis rD, hi; ori rD, rD, lo".
+
+#if ENABLE(ASSEMBLER) && CPU(PPC)
+
+#include "AssemblerBuffer.h"
+#include "JITCompilationEffort.h"
+#include <limits.h>
+#include <wtf/Assertions.h>
+
+namespace JSC {
+
+typedef uint32_t PPCWord;
+
+namespace PPCRegisters {
+typedef enum {
+    r0 = 0,
+    r1, // sp
+    r2,
+    r3,
+    r4,
+    r5,
+    r6,
+    r7,
+    r8,
+    r9,
+    r10,
+    r11,
+    r12,
+    r13,
+    r14,
+    r15,
+    r16,
+    r17,
+    r18,
+    r19,
+    r20,
+    r21,
+    r22,
+    r23,
+    r24,
+    r25,
+    r26,
+    r27,
+    r28,
+    r29,
+    r30,
+    r31,
+    sp = r1
+} RegisterID;
+
+typedef enum {
+    f0,
+    f1,
+    f2,
+    f3,
+    f4,
+    f5,
+    f6,
+    f7,
+    f8,
+    f9,
+    f10,
+    f11,
+    f12,
+    f13,
+    f14,
+    f15,
