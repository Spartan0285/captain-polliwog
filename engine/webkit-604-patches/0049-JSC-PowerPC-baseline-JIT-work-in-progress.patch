+    f23,
+    f24,
+    f25,
+    f26,
+    f27,
+    f28,
+    f29,
+    f30,
+    f31
+} FPRegisterID;
+
+typedef enum {
+    cr0 = 0,
+    cr1,
+    cr2,
+    cr3,
+    cr4,
+    cr5,
+    cr6,
+    cr7
+} CRegisterID;
+
+} // namespace PPCRegisters
+
+class PPCAssembler {
+public:
+    typedef PPCRegisters::RegisterID RegisterID;
+    typedef PPCRegisters::FPRegisterID FPRegisterID;
+    typedef PPCRegisters::CRegisterID CRegisterID;
+
+    static constexpr RegisterID firstRegister() { return PPCRegisters::r0; }
+    static constexpr RegisterID lastRegister() { return PPCRegisters::r31; }
+
+    static constexpr FPRegisterID firstFPRegister() { return PPCRegisters::f0; }
+    static constexpr FPRegisterID lastFPRegister() { return PPCRegisters::f31; }
+
+    PPCAssembler()
+        : m_indexOfLastWatchpoint(INT_MIN)
+        , m_indexOfTailOfLastWatchpoint(INT_MIN)
+    {
+    }
+
+    AssemblerBuffer& buffer() { return m_buffer; }
+
+    // Condition register bits within a field.
+    enum CRBit {
+        LT = 0,
+        GT = 1,
+        EQ = 2,
+        SO = 3, // also "unordered" after a floating point compare
+    };
+
+    // BO values for bc: branch if the CR bit is set, or clear, or always.
+    enum BranchOption {
+        BranchIfTrue = 12,
+        BranchIfFalse = 4,
+        BranchAlways = 20,
+    };
+
+    static int crBit(CRegisterID cr, CRBit bit) { return cr * 4 + bit; }
+
+    void emitInst(PPCWord op)
+    {
+        m_buffer.putInt(op);
+    }
+
+    // Instruction forms.
+
+    static PPCWord formD(int op, int rt, int ra, int imm)
+    {
+        return (op << 26) | ((rt & 31) << 21) | ((ra & 31) << 16) | (imm & 0xffff);
+    }
+
+    static PPCWord formX(int op, int rt, int ra, int rb, int xo, bool rc = false)
+    {
+        return (op << 26) | ((rt & 31) << 21) | ((ra & 31) << 16) | ((rb & 31) << 11) | (xo << 1) | (rc ? 1 : 0);
+    }
+
+    static PPCWord formXO(int rt, int ra, int rb, bool oe, int xo, bool rc = false)
+    {
+        return (31 << 26) | ((rt & 31) << 21) | ((ra & 31) << 16) | ((rb & 31) << 11) | (oe ? 0x400 : 0) | (xo << 1) | (rc ? 1 : 0);
+    }
+
+    static PPCWord formA(int op, int frt, int fra, int frb, int frc, int xo)
+    {
+        return (op << 26) | ((frt & 31) << 21) | ((fra & 31) << 16) | ((frb & 31) << 11) | ((frc & 31) << 6) | (xo << 1);
+    }
+
+    static PPCWord formM(int op, int rs, int ra, int sh, int mb, int me, bool rc = false)
+    {
+        return (op << 26) | ((rs & 31) << 21) | ((ra & 31) << 16) | ((sh & 31) << 11) | ((mb & 31) << 6) | ((me & 31) << 1) | (rc ? 1 : 0);
+    }
+
+    // Integer arithmetic. rt is the destination.
+
+    void addi(RegisterID rt, RegisterID ra, int16_t imm) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(14, rt, ra, imm)); }
+    void li(RegisterID rt, int16_t imm) { emitInst(formD(14, rt, 0, imm)); }
+    void addis(RegisterID rt, RegisterID ra, int16_t imm) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(15, rt, ra, imm)); }
+    void lis(RegisterID rt, int16_t imm) { emitInst(formD(15, rt, 0, imm)); }
+    void mulli(RegisterID rt, RegisterID ra, int16_t imm) { emitInst(formD(7, rt, ra, imm)); }
+    void subfic(RegisterID rt, RegisterID ra, int16_t imm) { emitInst(formD(8, rt, ra, imm)); }
+
+    void add(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 266)); }
+    void add_rc(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 266, true)); }
+    // subf rt, ra, rb: rt = rb - ra
+    void subf(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 40)); }
+    void subf_rc(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 40, true)); }
+    void mullw(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 235)); }
+    void mulhw(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 75)); }
+    void mulhwu(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 11)); }
+    void divw(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 491)); }
+    void divwu(RegisterID rt, RegisterID ra, RegisterID rb) { emitInst(formXO(rt, ra, rb, false, 459)); }
+    void neg(RegisterID rt, RegisterID ra) { emitInst(formXO(rt, ra, 0, false, 104)); }
+
+    // Logical operations. ra is the destination, rs the source.
+
+    void ori(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(24, rs, ra, imm)); }
+    void oris(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(25, rs, ra, imm)); }
+    void xori(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(26, rs, ra, imm)); }
+    void xoris(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(27, rs, ra, imm)); }
+    void andi_rc(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(28, rs, ra, imm)); }
+    void andis_rc(RegisterID ra, RegisterID rs, uint16_t imm) { emitInst(formD(29, rs, ra, imm)); }
+
+    void and_(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 28)); }
+    void and_rc(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 28, true)); }
+    void andc(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 60)); }
+    void or_(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 444)); }
+    void or_rc(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 444, true)); }
+    void mr(RegisterID ra, RegisterID rs) { if (ra != rs) or_(ra, rs, rs); }
+    void xor_(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 316)); }
+    void nor(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 124)); }
+    void slw(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 24)); }
+    void srw(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 536)); }
+    void sraw(RegisterID ra, RegisterID rs, RegisterID rb) { emitInst(formX(31, rs, ra, rb, 792)); }
+    void srawi(RegisterID ra, RegisterID rs, int sh) { emitInst(formX(31, rs, ra, sh, 824)); }
+    void cntlzw(RegisterID ra, RegisterID rs) { emitInst(formX(31, rs, ra, 0, 26)); }
+    void extsb(RegisterID ra, RegisterID rs) { emitInst(formX(31, rs, ra, 0, 954)); }
+    void extsh(RegisterID ra, RegisterID rs) { emitInst(formX(31, rs, ra, 0, 922)); }
+
+    void rlwinm(RegisterID ra, RegisterID rs, int sh, int mb, int me) { emitInst(formM(21, rs, ra, sh, mb, me)); }
+    void rlwnm(RegisterID ra, RegisterID rs, RegisterID rb, int mb, int me) { emitInst(formM(23, rs, ra, rb, mb, me)); }
+    void slwi(RegisterID ra, RegisterID rs, int n) { ASSERT(n > 0 && n < 32); rlwinm(ra, rs, n, 0, 31 - n); }
+    void srwi(RegisterID ra, RegisterID rs, int n) { ASSERT(n > 0 && n < 32); rlwinm(ra, rs, 32 - n, n, 31); }
+    // Clear the high n bits.
+    void clrlwi(RegisterID ra, RegisterID rs, int n) { rlwinm(ra, rs, 0, n, 31); }
+
+    // Comparisons.
+
+    void cmpw(CRegisterID cr, RegisterID ra, RegisterID rb) { emitInst(formX(31, cr << 2, ra, rb, 0)); }
+    void cmplw(CRegisterID cr, RegisterID ra, RegisterID rb) { emitInst(formX(31, cr << 2, ra, rb, 32)); }
+    void cmpwi(CRegisterID cr, RegisterID ra, int16_t imm) { emitInst(formD(11, cr << 2, ra, imm)); }
+    void cmplwi(CRegisterID cr, RegisterID ra, uint16_t imm) { emitInst(formD(10, cr << 2, ra, imm)); }
+
+    // Condition register logic on bit numbers.
+    void cror(int bt, int ba, int bb) { emitInst(formX(19, bt, ba, bb, 449)); }
+    void crorc(int bt, int ba, int bb) { emitInst(formX(19, bt, ba, bb, 417)); }
+    void crandc(int bt, int ba, int bb) { emitInst(formX(19, bt, ba, bb, 129)); }
+    void crnor(int bt, int ba, int bb) { emitInst(formX(19, bt, ba, bb, 33)); }
+    void mfcr(RegisterID rt) { emitInst(formX(31, rt, 0, 0, 19)); }
+
+    // Loads and stores. D-form: displacement(ra); X-form: ra + rb. ra may not
+    // be r0, which reads as zero.
+
+    void lwz(RegisterID rt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(32, rt, ra, d)); }
+    void lwzu(RegisterID rt, RegisterID ra, int16_t d) { emitInst(formD(33, rt, ra, d)); }
+    void lbz(RegisterID rt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(34, rt, ra, d)); }
+    void lhz(RegisterID rt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(40, rt, ra, d)); }
+    void lha(RegisterID rt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(42, rt, ra, d)); }
+    void stw(RegisterID rs, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(36, rs, ra, d)); }
+    void stwu(RegisterID rs, RegisterID ra, int16_t d) { emitInst(formD(37, rs, ra, d)); }
+    void stb(RegisterID rs, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(38, rs, ra, d)); }
+    void sth(RegisterID rs, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(44, rs, ra, d)); }
+    void lwzx(RegisterID rt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rt, ra, rb, 23)); }
+    void lbzx(RegisterID rt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rt, ra, rb, 87)); }
+    void lhzx(RegisterID rt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rt, ra, rb, 279)); }
+    void lhax(RegisterID rt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rt, ra, rb, 343)); }
+    void stwx(RegisterID rs, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rs, ra, rb, 151)); }
+    void stbx(RegisterID rs, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rs, ra, rb, 215)); }
+    void sthx(RegisterID rs, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, rs, ra, rb, 407)); }
+
+    void lfd(FPRegisterID frt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(50, frt, ra, d)); }
+    void lfs(FPRegisterID frt, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(48, frt, ra, d)); }
+    void stfd(FPRegisterID frs, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(54, frs, ra, d)); }
+    void stfs(FPRegisterID frs, RegisterID ra, int16_t d) { ASSERT(ra != PPCRegisters::r0); emitInst(formD(52, frs, ra, d)); }
+    void lfdx(FPRegisterID frt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, frt, ra, rb, 599)); }
+    void lfsx(FPRegisterID frt, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, frt, ra, rb, 535)); }
+    void stfdx(FPRegisterID frs, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, frs, ra, rb, 727)); }
+    void stfsx(FPRegisterID frs, RegisterID ra, RegisterID rb) { ASSERT(ra != PPCRegisters::r0); emitInst(formX(31, frs, ra, rb, 663)); }
+
+    // Floating point.
+
+    void fadd(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, 0, 21)); }
+    void fsub(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, 0, 20)); }
+    void fmul(FPRegisterID frt, FPRegisterID fra, FPRegisterID frc) { emitInst(formA(63, frt, fra, 0, frc, 25)); }
+    void fdiv(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, 0, 18)); }
+    void fadds(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(59, frt, fra, frb, 0, 21)); }
+    void fsubs(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(59, frt, fra, frb, 0, 20)); }
+    void fmuls(FPRegisterID frt, FPRegisterID fra, FPRegisterID frc) { emitInst(formA(59, frt, fra, 0, frc, 25)); }
+    void fdivs(FPRegisterID frt, FPRegisterID fra, FPRegisterID frb) { emitInst(formA(59, frt, fra, frb, 0, 18)); }
+    void fmr(FPRegisterID frt, FPRegisterID frb) { if (frt != frb) emitInst(formX(63, frt, 0, frb, 72)); }
+    void fneg(FPRegisterID frt, FPRegisterID frb) { emitInst(formX(63, frt, 0, frb, 40)); }
+    void fabs(FPRegisterID frt, FPRegisterID frb) { emitInst(formX(63, frt, 0, frb, 264)); }
+    void frsp(FPRegisterID frt, FPRegisterID frb) { emitInst(formX(63, frt, 0, frb, 12)); }
+    void fctiwz(FPRegisterID frt, FPRegisterID frb) { emitInst(formX(63, frt, 0, frb, 15)); }
+    void fcmpu(CRegisterID cr, FPRegisterID fra, FPRegisterID frb) { emitInst(formX(63, cr << 2, fra, frb, 0)); }
+    void frsqrte(FPRegisterID frt, FPRegisterID frb) { emitInst(formA(63, frt, 0, frb, 0, 26)); }
+    void fmadd(FPRegisterID frt, FPRegisterID fra, FPRegisterID frc, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, frc, 29)); }
+    void fnmsub(FPRegisterID frt, FPRegisterID fra, FPRegisterID frc, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, frc, 30)); }
+    void fsel(FPRegisterID frt, FPRegisterID fra, FPRegisterID frc, FPRegisterID frb) { emitInst(formA(63, frt, fra, frb, frc, 23)); }
+
+    // Special purpose registers and branches.
+
+    static PPCWord sprField(int spr) { return ((spr & 31) << 16) | ((spr >> 5) << 11); }
+    void mflr(RegisterID rt) { emitInst((31 << 26) | (rt << 21) | sprField(8) | (339 << 1)); }
+    void mtlr(RegisterID rs) { emitInst((31 << 26) | (rs << 21) | sprField(8) | (467 << 1)); }
+    void mtctr(RegisterID rs) { emitInst((31 << 26) | (rs << 21) | sprField(9) | (467 << 1)); }
+
+    static PPCWord bInstruction(int32_t offset, bool link) { return (18 << 26) | (offset & 0x03fffffc) | (link ? 1 : 0); }
+    static PPCWord bcInstruction(int bo, int bi, int32_t offset, bool link = false) { return (16 << 26) | (bo << 21) | (bi << 16) | (offset & 0xfffc) | (link ? 1 : 0); }
+
+    void b(int32_t offset) { emitInst(bInstruction(offset, false)); }
+    void bl(int32_t offset) { emitInst(bInstruction(offset, true)); }
+    void bc(int bo, int bi, int32_t offset) { emitInst(bcInstruction(bo, bi, offset)); }
+    void blr() { emitInst(0x4e800020); }
+    void bctr() { emitInst(0x4e800420); }
+    void bctrl() { emitInst(0x4e800421); }
+
+    void nop() { emitInst(0x60000000); }
+    void trap() { emitInst(0x7fe00008); }
+    void sync() { emitInst(0x7c0004ac); }
+    void lwsync() { emitInst(0x7c2004ac); } // executes as sync on the G3 and G4
+    void isync() { emitInst(0x4c00012c); }
+
+    static bool isTrap(void* address) { return *static_cast<PPCWord*>(address) == 0x7fe00008; }
+
+    static void fillNops(void* base, size_t size, bool isCopyingToExecutableMemory)
+    {
+        UNUSED_PARAM(isCopyingToExecutableMemory);
+        RELEASE_ASSERT(!(size % sizeof(PPCWord)));
+        PPCWord* ptr = static_cast<PPCWord*>(base);
+        for (size_t i = 0; i < size / sizeof(PPCWord); ++i)
+            *ptr++ = 0x60000000;
+    }
+
+    // Constants.
+
+    void load32Constant(RegisterID rt, int32_t value)
+    {
+        if (value >= -32768 && value <= 32767) {
+            li(rt, value);
+            return;
+        }
+        lis(rt, value >> 16);
+        if (value & 0xffff)
+            ori(rt, rt, value & 0xffff);
+    }
+
+    // Always two words, so it can be patched.
+    void load32ConstantPatchable(RegisterID rt, int32_t value)
+    {
+        lis(rt, value >> 16);
+        ori(rt, rt, value & 0xffff);
+    }
+
+    // Labels, jumps and calls.
+
+    AssemblerLabel labelIgnoringWatchpoints()
+    {
+        return m_buffer.label();
+    }
+
+    AssemblerLabel labelForWatchpoint()
+    {
+        AssemblerLabel result = m_buffer.label();
+        if (static_cast<int>(result.m_offset) != m_indexOfLastWatchpoint)
+            result = label();
+        m_indexOfLastWatchpoint = result.m_offset;
+        m_indexOfTailOfLastWatchpoint = result.m_offset + maxJumpReplacementSize();
+        return result;
+    }
+
+    AssemblerLabel label()
+    {
+        AssemblerLabel result = m_buffer.label();
+        while (UNLIKELY(static_cast<int>(result.m_offset) < m_indexOfTailOfLastWatchpoint)) {
+            nop();
+            result = m_buffer.label();
+        }
+        return result;
+    }
+
+    AssemblerLabel align(int alignment)
+    {
+        while (!m_buffer.isAligned(alignment))
+            trap();
+        return label();
+    }
+
+    // An unconditional jump: one "b" word. The label is after it.
+    AssemblerLabel jump()
+    {
+        b(0);
+        return m_buffer.label();
+    }
+
+    // A conditional jump on a CR bit: "bc !cond, +8; b 0". The label is after
+    // the stanza.
+    AssemblerLabel branch(int bit, bool branchIfSet)
+    {
+        bc(branchIfSet ? BranchIfFalse : BranchIfTrue, bit, 8);
+        b(0);
+        return m_buffer.label();
+    }
+
+    // A call to JIT code: "bl". The label is the return address.
+    AssemblerLabel nearCall()
+    {
+        bl(0);
+        return m_buffer.label();
+    }
+
+    // A call to anywhere: the four-word absolute stanza. The label is the
+    // return address.
+    AssemblerLabel call()
+    {
+        load32ConstantPatchable(PPCRegisters::r12, 0);
+        mtctr(PPCRegisters::r12);
+        bctrl();
+        return m_buffer.label();
+    }
+
+    AssemblerLabel callRegister(RegisterID target)
+    {
+        if (target != PPCRegisters::r12)
+            mr(PPCRegisters::r12, target);
+        mtctr(PPCRegisters::r12);
+        bctrl();
+        return m_buffer.label();
+    }
+
+    static void* getRelocatedAddress(void* code, AssemblerLabel label)
+    {
+        return reinterpret_cast<void*>(reinterpret_cast<char*>(code) + label.m_offset);
+    }
+
+    static int getDifferenceBetweenLabels(AssemblerLabel a, AssemblerLabel b)
+    {
+        return b.m_offset - a.m_offset;
+    }
+
+    size_t codeSize() const { return m_buffer.codeSize(); }
+
+    unsigned debugOffset() { return m_buffer.debugOffset(); }
+
+    static unsigned getCallReturnOffset(AssemblerLabel call)
+    {
+        return call.m_offset;
+    }
+
+    // Linking & patching.
+
+    static bool isB(PPCWord insn) { return (insn & 0xfc000003) == 0x48000000; }
+    static bool isBL(PPCWord insn) { return (insn & 0xfc000003) == 0x48000001; }
+    static bool isBC(PPCWord insn) { return (insn & 0xfc000003) == 0x40000000; }
+    static bool isLIS(PPCWord insn) { return (insn & 0xfc1f0000) == 0x3c000000; }
+    static bool isORI(PPCWord insn) { return (insn & 0xfc000000) == 0x60000000; }
+    static bool isNop(PPCWord insn) { return insn == 0x60000000; }
+    static int bcBO(PPCWord insn) { return (insn >> 21) & 31; }
+    static int bcBI(PPCWord insn) { return (insn >> 16) & 31; }
+
+    static bool fitsInBranch(intptr_t offset) { return offset >= -0x2000000 && offset <= 0x1fffffc; }
+    static bool fitsInConditionalBranch(intptr_t offset) { return offset >= -0x8000 && offset <= 0x7ffc; }
+
+    // Links the jump ending at "from" to "to", returning the first word
+    // patched. A jump is a "b"; a conditional jump is a "bc" before it, in one
+    // of the forms described at the top, which nothing else emits. The word
+    // before the jump is only examined at or after codeStart, when known.
+    static PPCWord* linkJumpAt(PPCWord* from, void* to, PPCWord* codeStart = nullptr)
+    {
+        PPCWord* insn = from - 1;
+        bool mayBeConditional = !codeStart || insn > codeStart;
+        if (mayBeConditional && isB(insn[0]) && isBC(insn[-1]) && ((insn[-1] & 0xfffc) == 8)) {
+            // "bc !cond, +8; b target": try the one-branch form.
+            PPCWord* bcWord = insn - 1;
+            intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(bcWord);
+            if (fitsInConditionalBranch(offset)) {
+                int bo = bcBO(*bcWord) == BranchIfTrue ? BranchIfFalse : BranchIfTrue;
+                *bcWord = bcInstruction(bo, bcBI(*bcWord), offset);
+                *insn = 0x60000000;
+                return bcWord;
+            }
+            offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(insn);
+            RELEASE_ASSERT(fitsInBranch(offset));
+            *insn = bInstruction(offset, false);
+            return bcWord;
+        }
+        if (mayBeConditional && isNop(insn[0]) && isBC(insn[-1])) {
+            // Already in the one-branch form: "bc cond, target; nop".
+            PPCWord* bcWord = insn - 1;
+            intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(bcWord);
+            if (fitsInConditionalBranch(offset)) {
+                *bcWord = bcInstruction(bcBO(*bcWord), bcBI(*bcWord), offset);
+                return bcWord;
+            }
+            // Back to the two-branch form.
+            int bo = bcBO(*bcWord) == BranchIfTrue ? BranchIfFalse : BranchIfTrue;
+            *bcWord = bcInstruction(bo, bcBI(*bcWord), 8);
+            offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(insn);
+            RELEASE_ASSERT(fitsInBranch(offset));
+            *insn = bInstruction(offset, false);
+            return bcWord;
+        }
+        RELEASE_ASSERT(isB(insn[0]));
+        intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(insn);
+        RELEASE_ASSERT(fitsInBranch(offset));
+        *insn = bInstruction(offset, false);
+        return insn;
+    }
+
+    void linkJump(AssemblerLabel from, AssemblerLabel to)
+    {
+        ASSERT(from.isSet() && to.isSet());
+        char* base = static_cast<char*>(m_buffer.data());
+        linkJumpAt(reinterpret_cast<PPCWord*>(base + from.m_offset), base + to.m_offset, reinterpret_cast<PPCWord*>(base));
+    }
+
+    static void linkJump(void* code, AssemblerLabel from, void* to)
+    {
+        ASSERT(from.isSet());
+        linkJumpAt(reinterpret_cast<PPCWord*>(static_cast<char*>(code) + from.m_offset), to, static_cast<PPCWord*>(code));
+    }
+
+    static void relinkJump(void* from, void* to)
+    {
+        PPCWord* start = linkJumpAt(static_cast<PPCWord*>(from), to);
+        cacheFlush(start, reinterpret_cast<char*>(from) - reinterpret_cast<char*>(start));
+    }
+
+    static void relinkJumpToNop(void* from)
+    {
+        relinkJump(from, from);
+    }
+
+    // Links the call whose return address is "from".
+    static void linkCallAt(PPCWord* from, void* to)
+    {
+        PPCWord* insn = from - 1;
+        if (isBL(*insn)) {
+            intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(insn);
+            RELEASE_ASSERT(fitsInBranch(offset));
+            *insn = bInstruction(offset, true);
+            return;
+        }
+        // lis r12; ori r12; mtctr r12; bctrl
+        setConstant(from - 4, reinterpret_cast<int32_t>(to));
+    }
+
+    static void linkCall(void* code, AssemblerLabel from, void* to)
+    {
+        linkCallAt(reinterpret_cast<PPCWord*>(static_cast<char*>(code) + from.m_offset), to);
+    }
+
+    static void relinkCall(void* from, void* to)
+    {
+        linkCallAt(static_cast<PPCWord*>(from), to);
+        cacheFlush(static_cast<PPCWord*>(from) - 4, 4 * sizeof(PPCWord));
+    }
+
+    static void* readCallTarget(void* from)
+    {
+        PPCWord* insn = static_cast<PPCWord*>(from) - 1;
+        if (isBL(*insn)) {
+            int32_t offset = static_cast<int32_t>(*insn & 0x03fffffc);
+            if (offset & 0x02000000)
+                offset -= 0x04000000;
+            return reinterpret_cast<char*>(insn) + offset;
+        }
+        return reinterpret_cast<void*>(getConstant(static_cast<PPCWord*>(from) - 4));
+    }
+
+    static void setConstant(PPCWord* insn, int32_t value)
+    {
+        ASSERT(isLIS(insn[0]) && isORI(insn[1]));
+        insn[0] = (insn[0] & 0xffff0000) | ((value >> 16) & 0xffff);
+        insn[1] = (insn[1] & 0xffff0000) | (value & 0xffff);
+    }
+
+    static int32_t getConstant(PPCWord* insn)
+    {
+        ASSERT(isLIS(insn[0]) && isORI(insn[1]));
+        return static_cast<int32_t>(((insn[0] & 0xffff) << 16) | (insn[1] & 0xffff));
+    }
+
+    // "where" is the start of a load32ConstantPatchable.
+    static void linkPointer(void* code, AssemblerLabel where, void* value)
+    {
+        setConstant(reinterpret_cast<PPCWord*>(static_cast<char*>(code) + where.m_offset), reinterpret_cast<int32_t>(value));
+    }
+
+    static void repatchInt32(void* where, int32_t value)
+    {
+        setConstant(static_cast<PPCWord*>(where), value);
+        cacheFlush(where, 2 * sizeof(PPCWord));
+    }
+
+    static void repatchCompact(void* where, int32_t value)
+    {
+        repatchInt32(where, value);
+    }
+
+    static void repatchPointer(void* where, void* value)
+    {
+        repatchInt32(where, reinterpret_cast<int32_t>(value));
+    }
+
+    static int32_t readInt32(void* where)
+    {
+        return getConstant(static_cast<PPCWord*>(where));
+    }
+
+    static void* readPointer(void* where)
+    {
+        return reinterpret_cast<void*>(readInt32(where));
+    }
+
+    // Jump replacement (for watchpoints and inline caches) overwrites one
+    // word with a "b" to JIT code.
+    static constexpr ptrdiff_t maxJumpReplacementSize()
+    {
+        return sizeof(PPCWord);
+    }
+
+    static constexpr ptrdiff_t patchableJumpSize()
+    {
+        return 2 * sizeof(PPCWord);
+    }
+
+    static void replaceWithJump(void* instructionStart, void* to)
+    {
+        PPCWord* insn = static_cast<PPCWord*>(instructionStart);
+        intptr_t offset = reinterpret_cast<intptr_t>(to) - reinterpret_cast<intptr_t>(insn);
+        RELEASE_ASSERT(fitsInBranch(offset));
+        *insn = bInstruction(offset, false);
+        cacheFlush(insn, sizeof(PPCWord));
+    }
+
+    // Undoes replaceWithJump over the first word of a patchable constant
+    // load.
+    static void revertJumpToLoad32ConstantPatchable(void* instructionStart, RegisterID rt, int32_t value)
+    {
+        PPCWord* insn = static_cast<PPCWord*>(instructionStart);
+        insn[0] = formD(15, rt, 0, (value >> 16) & 0xffff);
+        ASSERT(isORI(insn[1]));
+        insn[1] = (insn[1] & 0xffff0000) | (value & 0xffff);
+        cacheFlush(insn, 2 * sizeof(PPCWord));
+    }
+
+    // Load/LEA conversion, for the patchable "lis r0; ori r0; lwzx dest, base,
+    // r0" sequences (the lwzx is word 2).
+    static void replaceWithLoad(void* instructionStart)
+    {
+        PPCWord* insn = static_cast<PPCWord*>(instructionStart) + 2;
+        // add dest, base, r0 => lwzx dest, base, r0
+        if ((*insn & 0xfc0007fe) == ((31u << 26) | (266 << 1))) {
+            *insn = (*insn & ~0x7feu) | (23 << 1);
+            cacheFlush(insn, sizeof(PPCWord));
+        }
+    }
+
+    static void replaceWithAddressComputation(void* instructionStart)
+    {
+        PPCWord* insn = static_cast<PPCWord*>(instructionStart) + 2;
+        // lwzx dest, base, r0 => add dest, base, r0
+        if ((*insn & 0xfc0007fe) == ((31u << 26) | (23 << 1))) {
+            *insn = (*insn & ~0x7feu) | (266 << 1);
+            cacheFlush(insn, sizeof(PPCWord));
+        }
+    }
+
+    // Writes the data cache lines back to memory and invalidates the
+    // instruction cache over them. 32-byte lines (the G3 and G4; the G5's are
+    // larger, which a smaller stride covers too).
+    static void cacheFlush(void* code, size_t size)
+    {
+        const uintptr_t lineSize = 32;
+        uintptr_t start = reinterpret_cast<uintptr_t>(code) & ~(lineSize - 1);
+        uintptr_t end = reinterpret_cast<uintptr_t>(code) + size;
+        for (uintptr_t line = start; line < end; line += lineSize)
+            asm volatile("dcbst 0, %0" : : "r"(line) : "memory");
+        asm volatile("sync" : : : "memory");
+        for (uintptr_t line = start; line < end; line += lineSize)
+            asm volatile("icbi 0, %0" : : "r"(line) : "memory");
+        asm volatile("sync\n\tisync" : : : "memory");
+    }
+
+private:
+    AssemblerBuffer m_buffer;
+    int m_indexOfLastWatchpoint;
+    int m_indexOfTailOfLastWatchpoint;
+};
