+                                               [BaseIndex.new(node.codeOrigin, operand.base, operand.index, operand.scale,
+                                                              Immediate.new(node.codeOrigin, 0)), tmp])
+                    shared = [operand.base, operand.index, operand.scaleShift, tmp]
+                end
+                Address.new(node.codeOrigin, shared[3], operand.offset)
+            else
+                operand
+            end
+        }
+        newList << Instruction.new(node.codeOrigin, node.opcode, operands, node.annotation)
+        # A load that overwrites the base or the index ends the sharing.
+        if shared and node.opcode.start_with? "load"
+            destination = operands[-1]
+            shared = nil if destination == shared[0] or destination == shared[1]
+        end
+    }
