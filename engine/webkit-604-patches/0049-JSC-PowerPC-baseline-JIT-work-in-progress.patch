+#pragma once
+
+// The 32-bit PowerPC macro assembler for the baseline JIT. See
+// PPCAssemblerJIT.h for how jumps, calls and patchable constants are laid out.
+//
+// Scratch registers, none of which the JIT allocates (jit/GPRInfo.h):
+//   r0   tempRegister: data and immediates. Never a base address (as the base
+//        of a load, store or addi, r0 reads as zero).
+//   r12  addressTempRegister: computed addresses; also holds the target of
+//        every call, as Darwin expects.
+//   r11  dataTempRegister2: a second data temporary.
+//   f0, f13  floating point temporaries.
+// The red zone below the stack pointer (224 bytes on Darwin, and untouched by
+// signal handlers) is used for moves between GPRs and FPRs at -8(r1).
+
+#if ENABLE(ASSEMBLER) && CPU(PPC)
+
+#include "AbstractMacroAssembler.h"
+#include "PPCAssemblerJIT.h"
+
+namespace JSC {
+
+class MacroAssemblerPPC : public AbstractMacroAssembler<PPCAssembler> {
+public:
+    typedef PPCRegisters::FPRegisterID FPRegisterID;
+    static const unsigned numGPRs = 32;
+    static const unsigned numFPRs = 32;
+
+    static const RegisterID tempRegister = PPCRegisters::r0;
+    static const RegisterID addressTempRegister = PPCRegisters::r12;
+    static const RegisterID dataTempRegister2 = PPCRegisters::r11;
+    static const FPRegisterID fpTempRegister = PPCRegisters::f0;
+    static const FPRegisterID fpTempRegister2 = PPCRegisters::f13;
+
+    static const RegisterID stackPointerRegister = PPCRegisters::r1;
+    static const RegisterID framePointerRegister = PPCRegisters::r13;
+
+    static const Scale ScalePtr = TimesFour;
+    static const int MaximumCompactPtrAlignedAddressOffset = 0x7FFFFFFF;
+
+    static bool isCompactPtrAlignedAddressOffset(ptrdiff_t value)
+    {
+        return value >= -2147483647 - 1 && value <= 2147483647;
+    }
+
+    // Conditions are a bit of cr0 (LT, GT or EQ), whether to branch when it
+    // is set or clear, and for comparisons, whether they are unsigned.
+    enum {
+        ConditionSet = 4,
+        ConditionUnsigned = 8,
+    };
+
+    enum RelationalCondition {
+        Equal = PPCAssembler::EQ | ConditionSet,
+        NotEqual = PPCAssembler::EQ,
+        Above = PPCAssembler::GT | ConditionSet | ConditionUnsigned,
+        AboveOrEqual = PPCAssembler::LT | ConditionUnsigned,
+        Below = PPCAssembler::LT | ConditionSet | ConditionUnsigned,
+        BelowOrEqual = PPCAssembler::GT | ConditionUnsigned,
+        GreaterThan = PPCAssembler::GT | ConditionSet,
+        GreaterThanOrEqual = PPCAssembler::LT,
+        LessThan = PPCAssembler::LT | ConditionSet,
+        LessThanOrEqual = PPCAssembler::GT
+    };
+
+    enum ResultCondition {
+        Overflow = 16,
+        Signed = PPCAssembler::LT | ConditionSet,
+        PositiveOrZero = PPCAssembler::LT,
+        Zero = PPCAssembler::EQ | ConditionSet,
+        NonZero = PPCAssembler::EQ
+    };
+
+    enum DoubleCondition {
+        // These conditions will only evaluate to true if the comparison is ordered - i.e. neither operand is NaN.
+        DoubleEqual,
+        DoubleNotEqual,
+        DoubleGreaterThan,
+        DoubleGreaterThanOrEqual,
+        DoubleLessThan,
+        DoubleLessThanOrEqual,
+        // If either operand is NaN, these conditions always evaluate to true.
+        DoubleEqualOrUnordered,
+        DoubleNotEqualOrUnordered,
+        DoubleGreaterThanOrUnordered,
+        DoubleGreaterThanOrEqualOrUnordered,
+        DoubleLessThanOrUnordered,
+        DoubleLessThanOrEqualOrUnordered
+    };
+
+    static RelationalCondition invert(RelationalCondition cond)
+    {
+        return static_cast<RelationalCondition>(cond ^ ConditionSet);
+    }
+
+    static bool isInt16(int32_t value) { return value >= -32768 && value <= 32767; }
+    static bool isUInt16(int32_t value) { return !(value & 0xffff0000); }
+    // The high half for addis, adjusted for the sign of the low half.
+    static int16_t ha16(int32_t value) { return static_cast<int16_t>((value + 0x8000) >> 16); }
+    static int16_t lo16(int32_t value) { return static_cast<int16_t>(value & 0xffff); }
+
+    // Integer arithmetic operations.
+
+    void add32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.add(dest, dest, src);
+    }
+
+    void add32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.add(dest, op1, op2);
+    }
+
+    void add32(TrustedImm32 imm, RegisterID dest)
+    {
+        add32(imm, dest, dest);
+    }
+
+    void add32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        ASSERT(src != tempRegister);
+        int32_t value = imm.m_value;
+        if (isInt16(value)) {
+            if (value || src != dest)
+                m_assembler.addi(dest, src, value);
+            return;
+        }
+        if (!lo16(value)) {
+            m_assembler.addis(dest, src, value >> 16);
+            return;
+        }
+        m_assembler.addis(dest, src, ha16(value));
+        m_assembler.addi(dest, dest, lo16(value));
+    }
+
+    void add32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        add32(imm, src, dest);
+    }
+
+    void add32(TrustedImm32 imm, Address address)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lwz(dataTempRegister2, resolved.base, resolved.offset);
+        add32(imm, dataTempRegister2);
+        m_assembler.stw(dataTempRegister2, resolved.base, resolved.offset);
+    }
+
+    void add32(TrustedImm32 imm, AbsoluteAddress address)
+    {
+        add32(imm, absoluteAddress(address.m_ptr));
+    }
+
+    void add32(Address src, RegisterID dest)
+    {
+        load32(src, tempRegister);
+        add32(tempRegister, dest);
+    }
+
+    void add32(AbsoluteAddress src, RegisterID dest)
+    {
+        load32(src.m_ptr, tempRegister);
+        add32(tempRegister, dest);
+    }
+
+    void add32(RegisterID src, Address dest)
+    {
+        Address resolved = resolveAddress(dest);
+        m_assembler.lwz(tempRegister, resolved.base, resolved.offset);
+        m_assembler.add(tempRegister, tempRegister, src);
+        m_assembler.stw(tempRegister, resolved.base, resolved.offset);
+    }
+
+    // A 64-bit add of a sign-extended immediate to the (big-endian) 64-bit
+    // integer at the address.
+    void add64(TrustedImm32 imm, AbsoluteAddress address)
+    {
+        m_assembler.lis(addressTempRegister, ha16(reinterpret_cast<int32_t>(address.m_ptr)));
+        m_assembler.addi(addressTempRegister, addressTempRegister, lo16(reinterpret_cast<int32_t>(address.m_ptr)));
+        m_assembler.lwz(tempRegister, addressTempRegister, 4);
+        move(imm, dataTempRegister2);
+        // addc/adde: low word with carry out, then the high word.
+        m_assembler.emitInst(PPCAssembler::formXO(tempRegister, tempRegister, dataTempRegister2, false, 10)); // addc
+        m_assembler.stw(tempRegister, addressTempRegister, 4);
+        m_assembler.lwz(tempRegister, addressTempRegister, 0);
+        m_assembler.srawi(dataTempRegister2, dataTempRegister2, 31);
+        m_assembler.emitInst(PPCAssembler::formXO(tempRegister, tempRegister, dataTempRegister2, false, 138)); // adde
+        m_assembler.stw(tempRegister, addressTempRegister, 0);
+    }
+
+    void and32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.and_(dest, dest, src);
+    }
+
+    void and32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.and_(dest, op1, op2);
+    }
+
+    void and32(TrustedImm32 imm, RegisterID dest)
+    {
+        and32(imm, dest, dest);
+    }
+
+    void and32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        int32_t value = imm.m_value;
+        if (value == -1)
+            move(src, dest);
+        else if (isUInt16(value))
+            m_assembler.andi_rc(dest, src, value);
+        else if (!(value & 0xffff))
+            m_assembler.andis_rc(dest, src, static_cast<uint32_t>(value) >> 16);
+        else if (int mask = contiguousMask(value)) {
+            // rlwinm with a mask of consecutive ones, e.g. ~7 or 0x7fffffff.
+            m_assembler.rlwinm(dest, src, 0, (mask >> 8) & 31, mask & 31);
+        } else {
+            move(imm, tempRegister);
+            m_assembler.and_(dest, src, tempRegister);
+        }
+    }
+
+    void and32(Address src, RegisterID dest)
+    {
+        load32(src, tempRegister);
+        and32(tempRegister, dest);
+    }
+
+    void countLeadingZeros32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.cntlzw(dest, src);
+    }
+
+    void lshift32(RegisterID shiftAmount, RegisterID dest)
+    {
+        lshift32(dest, shiftAmount, dest);
+    }
+
+    void lshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        // JavaScript uses the low five bits of the amount; slw uses six.
+        m_assembler.andi_rc(tempRegister, shiftAmount, 31);
+        m_assembler.slw(dest, src, tempRegister);
+    }
+
+    void lshift32(TrustedImm32 imm, RegisterID dest)
+    {
+        lshift32(dest, imm, dest);
+    }
+
+    void lshift32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        int amount = imm.m_value & 31;
+        if (amount)
+            m_assembler.slwi(dest, src, amount);
+        else
+            move(src, dest);
+    }
+
+    void mul32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.mullw(dest, dest, src);
+    }
+
+    void mul32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.mullw(dest, op1, op2);
+    }
+
+    void mul32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        if (isInt16(imm.m_value))
+            m_assembler.mulli(dest, src, imm.m_value);
+        else {
+            move(imm, tempRegister);
+            m_assembler.mullw(dest, src, tempRegister);
+        }
+    }
+
+    void neg32(RegisterID srcDest)
+    {
+        m_assembler.neg(srcDest, srcDest);
+    }
+
+    void or32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.or_(dest, dest, src);
+    }
+
+    void or32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.or_(dest, op1, op2);
+    }
+
+    void or32(TrustedImm32 imm, RegisterID dest)
+    {
+        or32(imm, dest, dest);
+    }
+
+    void or32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        uint32_t value = imm.m_value;
+        if (!value) {
+            move(src, dest);
+            return;
+        }
+        if (value >> 16) {
+            m_assembler.oris(dest, src, value >> 16);
+            if (value & 0xffff)
+                m_assembler.ori(dest, dest, value & 0xffff);
+        } else
+            m_assembler.ori(dest, src, value);
+    }
+
+    void or32(TrustedImm32 imm, Address address)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lwz(tempRegister, resolved.base, resolved.offset);
+        or32(imm, tempRegister);
+        m_assembler.stw(tempRegister, resolved.base, resolved.offset);
+    }
+
+    void or32(TrustedImm32 imm, AbsoluteAddress address)
+    {
+        or32(imm, absoluteAddress(address.m_ptr));
+    }
+
+    void or32(RegisterID src, AbsoluteAddress address)
+    {
+        Address resolved = absoluteAddress(address.m_ptr);
+        m_assembler.lwz(tempRegister, resolved.base, resolved.offset);
+        m_assembler.or_(tempRegister, tempRegister, src);
+        m_assembler.stw(tempRegister, resolved.base, resolved.offset);
+    }
+
+    void or32(Address src, RegisterID dest)
+    {
+        load32(src, tempRegister);
+        or32(tempRegister, dest);
+    }
+
+    void rshift32(RegisterID shiftAmount, RegisterID dest)
+    {
+        rshift32(dest, shiftAmount, dest);
+    }
+
+    void rshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.andi_rc(tempRegister, shiftAmount, 31);
+        m_assembler.sraw(dest, src, tempRegister);
+    }
+
+    void rshift32(TrustedImm32 imm, RegisterID dest)
+    {
+        rshift32(dest, imm, dest);
+    }
+
+    void rshift32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        m_assembler.srawi(dest, src, imm.m_value & 31);
+    }
+
+    void urshift32(RegisterID shiftAmount, RegisterID dest)
+    {
+        urshift32(dest, shiftAmount, dest);
+    }
+
+    void urshift32(RegisterID src, RegisterID shiftAmount, RegisterID dest)
+    {
+        m_assembler.andi_rc(tempRegister, shiftAmount, 31);
+        m_assembler.srw(dest, src, tempRegister);
+    }
+
+    void urshift32(TrustedImm32 imm, RegisterID dest)
+    {
+        urshift32(dest, imm, dest);
+    }
+
+    void urshift32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        int amount = imm.m_value & 31;
+        if (amount)
+            m_assembler.srwi(dest, src, amount);
+        else
+            move(src, dest);
+    }
+
+    void sub32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.subf(dest, src, dest);
+    }
+
+    // dest = op1 - op2
+    void sub32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.subf(dest, op2, op1);
+    }
+
+    void sub32(TrustedImm32 imm, RegisterID dest)
+    {
+        sub32(dest, imm, dest);
+    }
+
+    void sub32(RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        if (imm.m_value == INT_MIN) {
+            move(imm, tempRegister);
+            m_assembler.subf(dest, tempRegister, src);
+            return;
+        }
+        add32(TrustedImm32(-imm.m_value), src, dest);
+    }
+
+    void sub32(TrustedImm32 imm, Address address)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lwz(dataTempRegister2, resolved.base, resolved.offset);
+        sub32(imm, dataTempRegister2);
+        m_assembler.stw(dataTempRegister2, resolved.base, resolved.offset);
+    }
+
+    void sub32(TrustedImm32 imm, AbsoluteAddress address)
+    {
+        sub32(imm, absoluteAddress(address.m_ptr));
+    }
+
+    void sub32(Address src, RegisterID dest)
+    {
+        load32(src, tempRegister);
+        sub32(tempRegister, dest);
+    }
+
+    void xor32(RegisterID src, RegisterID dest)
+    {
+        m_assembler.xor_(dest, dest, src);
+    }
+
+    void xor32(RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        m_assembler.xor_(dest, op1, op2);
+    }
+
+    void xor32(TrustedImm32 imm, RegisterID dest)
+    {
+        xor32(imm, dest, dest);
+    }
+
+    void xor32(TrustedImm32 imm, RegisterID src, RegisterID dest)
+    {
+        uint32_t value = imm.m_value;
+        if (value == 0xffffffff) {
+            m_assembler.nor(dest, src, src);
+            return;
+        }
+        if (!value) {
+            move(src, dest);
+            return;
+        }
+        if (value >> 16) {
+            m_assembler.xoris(dest, src, value >> 16);
+            if (value & 0xffff)
+                m_assembler.xori(dest, dest, value & 0xffff);
+        } else
+            m_assembler.xori(dest, src, value);
+    }
+
+    void xor32(Address src, RegisterID dest)
+    {
+        load32(src, tempRegister);
+        xor32(tempRegister, dest);
+    }
+
+    void not32(RegisterID srcDest)
+    {
+        m_assembler.nor(srcDest, srcDest, srcDest);
+    }
+
+    // Memory access operations.
+
+    void lea(Address address, RegisterID dest)
+    {
+        add32(TrustedImm32(address.offset), address.base, dest);
+    }
+
+    void lea(BaseIndex address, RegisterID dest)
+    {
+        RegisterID index = address.index;
+        if (address.scale) {
+            m_assembler.slwi(addressTempRegister, index, address.scale);
+            index = addressTempRegister;
+        }
+        m_assembler.add(dest, address.base, index);
+        if (address.offset)
+            add32(TrustedImm32(address.offset), dest);
+    }
+
+    void load8(ImplicitAddress address, RegisterID dest)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lbz(dest, resolved.base, resolved.offset);
+    }
+
+    void load8(BaseIndex address, RegisterID dest)
+    {
+        if (RegisterID index = indexForXForm(address))
+            m_assembler.lbzx(dest, address.base, index);
+        else {
+            Address resolved = resolveAddress(address);
+            m_assembler.lbz(dest, resolved.base, resolved.offset);
+        }
+    }
+
+    void load8(const void* address, RegisterID dest)
+    {
+        Address resolved = absoluteAddress(address);
+        m_assembler.lbz(dest, resolved.base, resolved.offset);
+    }
+
+    void load8(AbsoluteAddress address, RegisterID dest)
+    {
+        load8(address.m_ptr, dest);
+    }
+
+    void load8SignedExtendTo32(ImplicitAddress address, RegisterID dest)
+    {
+        load8(address, dest);
+        m_assembler.extsb(dest, dest);
+    }
+
+    void load8SignedExtendTo32(BaseIndex address, RegisterID dest)
+    {
+        load8(address, dest);
+        m_assembler.extsb(dest, dest);
+    }
+
+    void load8SignedExtendTo32(const void* address, RegisterID dest)
+    {
+        load8(address, dest);
+        m_assembler.extsb(dest, dest);
+    }
+
+    void load8SignedExtendTo32(AbsoluteAddress address, RegisterID dest)
+    {
+        load8SignedExtendTo32(address.m_ptr, dest);
+    }
+
+    void load16(ImplicitAddress address, RegisterID dest)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lhz(dest, resolved.base, resolved.offset);
+    }
+
+    void load16(BaseIndex address, RegisterID dest)
+    {
+        if (RegisterID index = indexForXForm(address))
+            m_assembler.lhzx(dest, address.base, index);
+        else {
+            Address resolved = resolveAddress(address);
+            m_assembler.lhz(dest, resolved.base, resolved.offset);
+        }
+    }
+
+    // PowerPC handles misaligned loads in hardware in big-endian mode.
+    void load16Unaligned(BaseIndex address, RegisterID dest)
+    {
+        load16(address, dest);
+    }
+
+    void load16SignedExtendTo32(ImplicitAddress address, RegisterID dest)
+    {
+        Address resolved = resolveAddress(address);
+        m_assembler.lha(dest, resolved.base, resolved.offset);
