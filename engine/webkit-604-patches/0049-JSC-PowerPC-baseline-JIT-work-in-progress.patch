+    {
+        load32(src.m_ptr, dataTempRegister2);
+        convertInt32ToDouble(dataTempRegister2, dest);
+    }
+
+    void convertUInt32ToDouble(RegisterID src, FPRegisterID dest)
+    {
+        // 0x43300000:x is 2^52 + x.
+        m_assembler.lis(tempRegister, 0x4330);
+        m_assembler.stw(tempRegister, stackPointerRegister, -8);
+        m_assembler.stw(src, stackPointerRegister, -4);
+        m_assembler.lfd(dest, stackPointerRegister, -8);
+        loadDouble(TrustedImmPtr(&s_uint32ToDoubleBias), fpTempRegister2);
+        m_assembler.fsub(dest, dest, fpTempRegister2);
+    }
+
+    // fctiwz saturates: 0x7fffffff for large values, 0x80000000 for small
+    // ones and NaN.
+    void truncateDoubleToInt32(FPRegisterID src, RegisterID dest)
+    {
+        m_assembler.fctiwz(fpTempRegister, src);
+        m_assembler.stfd(fpTempRegister, stackPointerRegister, -8);
+        m_assembler.lwz(dest, stackPointerRegister, -4);
+    }
+
+    void truncateDoubleToUint32(FPRegisterID src, RegisterID dest)
+    {
+        truncateDoubleToInt32(src, dest);
+    }
+
+    enum BranchTruncateType { BranchIfTruncateFailed, BranchIfTruncateSuccessful };
+
+    // Treats the saturated results, INT_MAX and INT_MIN, as failures.
+    Jump branchTruncateDoubleToInt32(FPRegisterID src, RegisterID dest, BranchTruncateType branchType = BranchIfTruncateFailed)
+    {
+        truncateDoubleToInt32(src, dest);
+        // x ^ 0x80000000, plus 1: 0 for INT_MAX, 1 for INT_MIN.
+        m_assembler.xoris(dataTempRegister2, dest, 0x8000);
+        m_assembler.addi(dataTempRegister2, dataTempRegister2, 1);
+        m_assembler.cmplwi(PPCRegisters::cr0, dataTempRegister2, 1);
+        return branchOnCondition(branchType == BranchIfTruncateFailed ? BelowOrEqual : Above);
+    }
+
+    Jump branchTruncateDoubleToUint32(FPRegisterID src, RegisterID dest, BranchTruncateType branchType = BranchIfTruncateFailed)
+    {
+        return branchTruncateDoubleToInt32(src, dest, branchType);
+    }
+
+    // Converts src to dest, adding a failure case if the double is not exactly
+    // an int32 (or might be -0, when negZeroCheck).
+    void branchConvertDoubleToInt32(FPRegisterID src, RegisterID dest, JumpList& failureCases, FPRegisterID fpTemp, bool negZeroCheck = true)
+    {
+        truncateDoubleToInt32(src, dest);
+        if (negZeroCheck)
+            failureCases.append(branchTest32(Zero, dest));
+        convertInt32ToDouble(dest, fpTemp);
+        failureCases.append(branchDouble(DoubleNotEqualOrUnordered, fpTemp, src));
+    }
+
+    Jump branchDouble(DoubleCondition cond, FPRegisterID left, FPRegisterID right)
+    {
+        m_assembler.fcmpu(PPCRegisters::cr0, left, right);
+        const int LT = PPCAssembler::LT, GT = PPCAssembler::GT, EQ = PPCAssembler::EQ, UN = PPCAssembler::SO;
+        switch (cond) {
+        case DoubleEqual:
+            return Jump(m_assembler.branch(EQ, true));
+        case DoubleNotEqual:
+            m_assembler.cror(EQ, EQ, UN);
+            return Jump(m_assembler.branch(EQ, false));
+        case DoubleGreaterThan:
+            return Jump(m_assembler.branch(GT, true));
+        case DoubleGreaterThanOrEqual:
+            m_assembler.cror(EQ, EQ, GT);
+            return Jump(m_assembler.branch(EQ, true));
+        case DoubleLessThan:
+            return Jump(m_assembler.branch(LT, true));
+        case DoubleLessThanOrEqual:
+            m_assembler.cror(EQ, EQ, LT);
+            return Jump(m_assembler.branch(EQ, true));
+        case DoubleEqualOrUnordered:
+            m_assembler.cror(EQ, EQ, UN);
+            return Jump(m_assembler.branch(EQ, true));
+        case DoubleNotEqualOrUnordered:
+            return Jump(m_assembler.branch(EQ, false));
+        case DoubleGreaterThanOrUnordered:
+            m_assembler.cror(GT, GT, UN);
+            return Jump(m_assembler.branch(GT, true));
+        case DoubleGreaterThanOrEqualOrUnordered:
+            return Jump(m_assembler.branch(LT, false));
+        case DoubleLessThanOrUnordered:
+            m_assembler.cror(LT, LT, UN);
+            return Jump(m_assembler.branch(LT, true));
+        case DoubleLessThanOrEqualOrUnordered:
+            return Jump(m_assembler.branch(GT, false));
+        }
+        RELEASE_ASSERT_NOT_REACHED();
+        return Jump();
+    }
+
+    Jump branchDoubleNonZero(FPRegisterID reg, FPRegisterID scratch)
+    {
+        moveZeroToDouble(scratch);
+        return branchDouble(DoubleNotEqual, reg, scratch);
+    }
