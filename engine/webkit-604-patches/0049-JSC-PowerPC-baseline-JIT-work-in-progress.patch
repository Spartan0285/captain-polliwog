+    // The sum is stored whether or not the branch is taken.
+    Jump branchAdd32(ResultCondition cond, TrustedImm32 imm, AbsoluteAddress dest)
+    {
+        load32(dest.m_ptr, dataTempRegister2);
+        int condition = add32SettingCondition(cond, dataTempRegister2, imm, dataTempRegister2);
+        store32(dataTempRegister2, dest.m_ptr);
+        return branchOnCondition(condition);
+    }
+
+    Jump branchAdd32(ResultCondition cond, TrustedImm32 imm, Address dest)
+    {
+        ASSERT(dest.base != addressTempRegister);
+        load32(dest, dataTempRegister2);
+        int condition = add32SettingCondition(cond, dataTempRegister2, imm, dataTempRegister2);
+        store32(dataTempRegister2, dest);
+        return branchOnCondition(condition);
+    }
+
+    Jump branchMul32(ResultCondition cond, RegisterID src1, RegisterID src2, RegisterID dest)
+    {
+        if (cond == Overflow) {
+            m_assembler.mulhw(dataTempRegister2, src1, src2);
+            m_assembler.mullw(tempRegister, src1, src2);
+            m_assembler.srawi(addressTempRegister, tempRegister, 31);
+            m_assembler.cmpw(PPCRegisters::cr0, dataTempRegister2, addressTempRegister);
+            move(tempRegister, dest);
+            return Jump(m_assembler.branch(PPCAssembler::EQ, false));
+        }
+        m_assembler.mullw(dest, src1, src2);
+        m_assembler.cmpwi(PPCRegisters::cr0, dest, 0);
+        return branchOnCondition(cond);
+    }
+
+    Jump branchMul32(ResultCondition cond, RegisterID src, RegisterID dest)
+    {
+        return branchMul32(cond, src, dest, dest);
+    }
+
+    Jump branchMul32(ResultCondition cond, RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        move(imm, dataTempRegister2);
+        ASSERT(src != dataTempRegister2);
+        m_assembler.mulhw(addressTempRegister, src, dataTempRegister2);
+        m_assembler.mullw(tempRegister, src, dataTempRegister2);
+        if (cond == Overflow) {
+            m_assembler.srawi(dataTempRegister2, tempRegister, 31);
+            m_assembler.cmpw(PPCRegisters::cr0, addressTempRegister, dataTempRegister2);
+            move(tempRegister, dest);
+            return Jump(m_assembler.branch(PPCAssembler::EQ, false));
+        }
+        move(tempRegister, dest);
+        m_assembler.cmpwi(PPCRegisters::cr0, dest, 0);
+        return branchOnCondition(cond);
+    }
+
+    Jump branchSub32(ResultCondition cond, RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        if (cond == Overflow) {
+            // op1 - op2 overflows when the operands' signs differ and the
+            // result's sign differs from op1's.
+            m_assembler.subf(tempRegister, op2, op1);
+            m_assembler.xor_(addressTempRegister, op1, op2);
+            m_assembler.xor_(dataTempRegister2, op1, tempRegister);
+            m_assembler.and_rc(dataTempRegister2, dataTempRegister2, addressTempRegister);
+            move(tempRegister, dest);
+            return Jump(m_assembler.branch(PPCAssembler::LT, true));
+        }
+        m_assembler.subf_rc(dest, op2, op1);
+        return branchOnCondition(cond);
+    }
+
+    Jump branchSub32(ResultCondition cond, RegisterID src, RegisterID dest)
+    {
+        return branchSub32(cond, dest, src, dest);
+    }
+
+    Jump branchSub32(ResultCondition cond, RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        if (imm.m_value == INT_MIN) {
+            move(imm, dataTempRegister2);
+            ASSERT(src != dataTempRegister2);
+            return branchSub32(cond, src, dataTempRegister2, dest);
+        }
+        return branchAdd32(cond, src, TrustedImm32(-imm.m_value), dest);
+    }
+
+    Jump branchSub32(ResultCondition cond, TrustedImm32 imm, RegisterID dest)
+    {
+        return branchSub32(cond, dest, imm, dest);
+    }
+
+    Jump branchNeg32(ResultCondition cond, RegisterID srcDest)
+    {
+        if (cond == Overflow) {
+            // Only INT_MIN overflows.
+            m_assembler.xoris(tempRegister, srcDest, 0x8000);
+            m_assembler.cmpwi(PPCRegisters::cr0, tempRegister, 0);
+            m_assembler.neg(srcDest, srcDest);
+            return Jump(m_assembler.branch(PPCAssembler::EQ, true));
+        }
+        m_assembler.neg(srcDest, srcDest);
+        m_assembler.cmpwi(PPCRegisters::cr0, srcDest, 0);
+        return branchOnCondition(cond);
+    }
+
+    Jump branchOr32(ResultCondition cond, RegisterID src, RegisterID dest)
+    {
+        ASSERT(cond != Overflow);
+        m_assembler.or_rc(dest, dest, src);
+        return branchOnCondition(cond);
+    }
