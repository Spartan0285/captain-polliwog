+#
+# The LLInt's dispatch, "addp n, PC; jmp [PC]", becomes a load with update:
+# lwzu r0, n(PC); mtctr r0; bctr.
+#
+
+def ppcLowerDispatch(list)
+    newList = []
+    list.each_with_index {
+        | node, index |
+        following = list[index + 1]
+        if node.is_a? Instruction and node.opcode == "addp" and node.operands.size == 2 and
+                node.operands[0].immediate? and ppcFitsSigned16(node.operands[0].value) and
+                node.operands[1].register? and
+                following.is_a? Instruction and following.opcode == "jmp" and
+                following.operands[0].is_a? Address and following.operands[0].base == node.operands[1] and
+                following.operands[0].offset.value == 0
+            newList << Instruction.new(node.codeOrigin, "ppcdispatch", node.operands, node.annotation)
+        elsif node.is_a? Instruction and node.opcode == "jmp" and index > 0 and
+                newList[-1].is_a? Instruction and newList[-1].opcode == "ppcdispatch" and
+                list[index - 1].is_a? Instruction and list[index - 1].opcode == "addp"
+            # Folded into the ppcdispatch above.
+        else
+            newList << node
+        end
+    }
+    newList
