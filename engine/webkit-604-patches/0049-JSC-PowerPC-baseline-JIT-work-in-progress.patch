+private:
+    friend class LinkBuffer;
+
+    static void linkCall(void* code, Call call, FunctionPtr function)
+    {
+        if (call.isFlagSet(Call::Tail))
+            PPCAssembler::linkJump(code, call.m_label, function.value());
+        else
+            PPCAssembler::linkCall(code, call.m_label, function.value());
+    }
+
+    // C calls pass argument words 4-7 in r7-r10. CCallHelpers pokes them into
+    // their stack slots, sp + 40 to sp + 52 (POKE_ARGUMENT_OFFSET), and the
+    // next call loads them.
+    static const int firstPokedArgumentOffset = 40;
+
+    void notePokedArgument(ImplicitAddress address)
+    {
+        if (address.base != stackPointerRegister)
+            return;
+        int word = (address.offset - firstPokedArgumentOffset) / 4;
+        if (address.offset >= firstPokedArgumentOffset && !(address.offset & 3) && word < 4)
+            m_pokedArguments |= 1 << word;
+    }
+
+    void loadPokedArguments()
+    {
+        for (int word = 0; word < 4; ++word) {
+            if (m_pokedArguments & (1 << word))
+                m_assembler.lwz(static_cast<RegisterID>(PPCRegisters::r7 + word), stackPointerRegister, firstPokedArgumentOffset + 4 * word);
+        }
+        m_pokedArguments = 0;
+    }
+
+    unsigned m_pokedArguments { 0 };
+
+    // A base register and 16-bit displacement for the address, using
+    // addressTempRegister when the offset doesn't fit.
+    Address resolveAddress(ImplicitAddress address)
+    {
+        ASSERT(address.base != tempRegister);
+        if (isInt16(address.offset))
+            return Address(address.base, address.offset);
+        m_assembler.addis(addressTempRegister, address.base, ha16(address.offset));
+        return Address(addressTempRegister, lo16(address.offset));
+    }
+
+    Address resolveAddress(BaseIndex address)
+    {
+        ASSERT(address.base != tempRegister && address.index != tempRegister);
+        RegisterID index = address.index;
+        if (address.scale) {
+            m_assembler.slwi(addressTempRegister, index, address.scale);
+            index = addressTempRegister;
+        }
+        m_assembler.add(addressTempRegister, address.base, index);
+        return resolveAddress(Address(addressTempRegister, address.offset));
+    }
+
+    // For an offsetless BaseIndex, the index register for an X-form access
+    // (base + index), scaled into addressTempRegister if need be. Otherwise
+    // r0, which is never an index, to say "use resolveAddress".
+    RegisterID indexForXForm(BaseIndex address)
+    {
+        if (address.offset)
+            return PPCRegisters::r0;
+        ASSERT(address.base != tempRegister && address.index != tempRegister);
+        if (!address.scale)
+            return address.index;
+        m_assembler.slwi(addressTempRegister, address.index, address.scale);
+        return addressTempRegister;
+    }
+
+    Address absoluteAddress(const void* address)
+    {
+        int32_t value = reinterpret_cast<int32_t>(address);
+        m_assembler.lis(addressTempRegister, ha16(value));
+        return Address(addressTempRegister, lo16(value));
+    }
+
+    // A mask of contiguous ones as rlwinm's (mb << 8) | me, or 0.
+    static int contiguousMask(uint32_t value)
+    {
+        if (!value || value == 0xffffffff)
+            return 0;
+        // Big-endian bit numbering: bit 0 is the most significant.
+        int mb = __builtin_clz(value);
+        int me = 31 - __builtin_ctz(value);
+        uint32_t expected = (0xffffffffu >> mb) & (0xffffffffu << (31 - me));
+        if (expected != value)
+            return 0;
+        return (mb << 8) | me | 0x10000;
+    }
+
+    void compare(RelationalCondition cond, RegisterID left, RegisterID right)
+    {
+        if (cond & ConditionUnsigned)
+            m_assembler.cmplw(PPCRegisters::cr0, left, right);
+        else
+            m_assembler.cmpw(PPCRegisters::cr0, left, right);
+    }
+
+    void compare(RelationalCondition cond, RegisterID left, TrustedImm32 right)
+    {
+        int32_t value = right.m_value;
+        if (cond & ConditionUnsigned) {
+            if (isUInt16(value)) {
+                m_assembler.cmplwi(PPCRegisters::cr0, left, value);
+                return;
+            }
+        } else if (isInt16(value)) {
+            m_assembler.cmpwi(PPCRegisters::cr0, left, value);
+            return;
+        }
+        ASSERT(left != tempRegister);
+        move(right, tempRegister);
+        compare(cond, left, tempRegister);
+    }
+
+    // Sets cr0 from reg & mask: EQ if zero, LT if negative.
+    void test(RegisterID reg, TrustedImm32 mask)
+    {
+        uint32_t value = mask.m_value;
+        if (value == 0xffffffff)
+            m_assembler.cmpwi(PPCRegisters::cr0, reg, 0);
+        else if (!(value >> 16))
+            m_assembler.andi_rc(tempRegister, reg, value);
+        else if (!(value & 0xffff))
+            m_assembler.andis_rc(tempRegister, reg, value >> 16);
+        else {
+            ASSERT(reg != tempRegister);
+            move(mask, tempRegister);
+            m_assembler.and_rc(tempRegister, reg, tempRegister);
+        }
+    }
+
+    // Adds, leaving cr0 set up for branchOnCondition with the condition
+    // returned. For Overflow, LT is set when the addition overflowed.
+    int add32SettingCondition(ResultCondition cond, RegisterID op1, RegisterID op2, RegisterID dest)
+    {
+        if (cond == Overflow) {
+            m_assembler.add(tempRegister, op1, op2);
+            m_assembler.xor_(addressTempRegister, tempRegister, op1);
+            m_assembler.xor_(dataTempRegister2, tempRegister, op2);
+            m_assembler.and_rc(dataTempRegister2, dataTempRegister2, addressTempRegister);
+            move(tempRegister, dest);
+            return Signed;
+        }
+        m_assembler.add_rc(dest, op1, op2);
+        return cond;
+    }
+
+    int add32SettingCondition(ResultCondition cond, RegisterID src, TrustedImm32 imm, RegisterID dest)
+    {
+        if (cond == Overflow) {
+            add32(imm, src, tempRegister);
+            // With a positive immediate, overflow turns a non-negative src
+            // negative; with a negative one, a negative src non-negative.
+            if (imm.m_value >= 0)
+                m_assembler.andc(dataTempRegister2, tempRegister, src);
+            else
+                m_assembler.andc(dataTempRegister2, src, tempRegister);
+            m_assembler.cmpwi(PPCRegisters::cr0, dataTempRegister2, 0);
+            move(tempRegister, dest);
+            return Signed;
+        }
+        add32(imm, src, dest);
+        m_assembler.cmpwi(PPCRegisters::cr0, dest, 0);
+        return cond;
+    }
+
+    Jump branchOnCondition(int cond)
+    {
+        return Jump(m_assembler.branch(cond & 3, cond & ConditionSet));
+    }
+
+    // dest = the condition on cr0 ? 1 : 0
+    void setFromCondition(int cond, RegisterID dest)
+    {
+        m_assembler.mfcr(tempRegister);
+        // Rotate the cr0 bit into the least significant position.
+        m_assembler.rlwinm(dest, tempRegister, (cond & 3) + 1, 31, 31);
+        if (!(cond & ConditionSet))
+            m_assembler.xori(dest, dest, 1);
+    }
+
+    static const double s_zeroDouble;
+    static const double s_int32ToDoubleBias;
+    static const double s_uint32ToDoubleBias;
+};
+
+} // namespace JSC
