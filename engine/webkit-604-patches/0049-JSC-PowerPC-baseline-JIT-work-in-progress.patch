+# loads and stores through the same base, index and scale (a JSValue's tag and
+# payload, typically) share one computed address:
+#
+#   loadi 0[cfr, t2, 8], t1         slwi r0, t2, 3
+#   loadi 4[cfr, t2, 8], t0   =>    add tmp, cfr, r0
+#                                   lwz t1, 0(tmp)
+#                                   lwz t0, 4(tmp)
+#
+
+PPC_SIMPLE_MEMORY_OPCODES = ["loadi", "loadis", "loadp", "loadb", "loadbs", "loadh", "loadhs", "loadd",
+                             "storei", "storep", "storeb", "storeh", "stored"]
+
+def ppcLowerBaseIndexes(list)
+    newList = []
+    shared = nil # [base, index, scaleShift, tmp]
+    list.each {
+        | node |
+        unless node.is_a? Instruction and PPC_SIMPLE_MEMORY_OPCODES.include? node.opcode
+            shared = nil
+            newList << node
+            next
+        end
+        operands = node.operands.map {
+            | operand |
+            if operand.is_a? BaseIndex and (operand.scaleShift != 0 or operand.offset.value != 0) and
+                    ppcFitsSigned16(operand.offset.value)
