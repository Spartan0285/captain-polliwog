 // The state machine loop
+// Media Queries 4 range syntax, "(width >= 600px)" or "(400px <= width <
+// 900px)", which newer style sheets use everywhere, rewritten into the
+// min-/max- form this parser reads. A strict < or > is taken as <= or >=.
+static bool isRangeFeature(StringView name)
+{
+    static const char* const features[] = {
+        "width", "height", "device-width", "device-height", "aspect-ratio", "device-aspect-ratio",
+        "resolution", "color", "color-index", "monochrome", "-webkit-device-pixel-ratio", nullptr
+    };
+    for (unsigned i = 0; features[i]; ++i) {
+        if (equalIgnoringASCIICase(name, features[i]))
+            return true;
+    }
+    return false;
+}
+
+enum class RangeComparison { None, Less, Greater, Equal };
+
+static RangeComparison consumeComparison(const Vector<CSSParserToken>& tokens, unsigned& index)
+{
+    if (index >= tokens.size() || tokens[index].type() != DelimiterToken)
+        return RangeComparison::None;
+    UChar first = tokens[index].delimiter();
+    if (first != '<' && first != '>' && first != '=')
+        return RangeComparison::None;
+    ++index;
+    if (first != '=' && index < tokens.size() && tokens[index].type() == DelimiterToken && tokens[index].delimiter() == '=')
+        ++index;
+    return first == '<' ? RangeComparison::Less : first == '>' ? RangeComparison::Greater : RangeComparison::Equal;
+}
+
+static void appendRangeExpression(Vector<CSSParserToken>& out, Vector<String>& names, StringView feature, RangeComparison comparison, const Vector<CSSParserToken>& value)
+{
+    if (!out.isEmpty() && out.last().type() == RightParenthesisToken) {
+        out.append(CSSParserToken(WhitespaceToken));
+        out.append(CSSParserToken(IdentToken, StringView(names[0])));
+        out.append(CSSParserToken(WhitespaceToken));
+    }
+    String name = comparison == RangeComparison::Greater ? makeString("min-", feature.toString())
+        : comparison == RangeComparison::Less ? makeString("max-", feature.toString()) : feature.toString();
+    names.append(name);
+    out.append(CSSParserToken(LeftParenthesisToken, CSSParserToken::BlockStart));
+    out.append(CSSParserToken(IdentToken, StringView(names.last())));
+    out.append(CSSParserToken(ColonToken));
+    out.appendVector(value);
+    out.append(CSSParserToken(RightParenthesisToken, CSSParserToken::BlockEnd));
+}
+
+static RangeComparison reversed(RangeComparison comparison)
+{
+    return comparison == RangeComparison::Less ? RangeComparison::Greater : comparison == RangeComparison::Greater ? RangeComparison::Less : comparison;
+}
+
+// One parenthesized group, without its parentheses or white space, as the
+// old syntax; false if it is not range syntax.
+static bool rewriteRangeGroup(const Vector<CSSParserToken>& group, Vector<CSSParserToken>& out, Vector<String>& names)
+{
+    Vector<unsigned> comparisons;
+    for (unsigned i = 0; i < group.size(); ++i) {
+        if (group[i].type() == DelimiterToken && (group[i].delimiter() == '<' || group[i].delimiter() == '>' || group[i].delimiter() == '='))
+            comparisons.append(i);
+    }
+    if (comparisons.isEmpty())
+        return false;
+
+    // Split into operands and comparisons.
+    Vector<Vector<CSSParserToken>> operands(1);
+    Vector<RangeComparison> operators;
+    for (unsigned i = 0; i < group.size();) {
+        unsigned before = i;
+        RangeComparison comparison = consumeComparison(group, i);
+        if (comparison != RangeComparison::None) {
+            operators.append(comparison);
+            operands.append(Vector<CSSParserToken>());
+            continue;
+        }
+        i = before + 1;
+        operands.last().append(group[before]);
+    }
+    for (auto& operand : operands) {
+        if (operand.isEmpty())
+            return false;
+    }
+
+    auto isFeature = [] (const Vector<CSSParserToken>& operand) {
+        return operand.size() == 1 && operand[0].type() == IdentToken && isRangeFeature(operand[0].value());
+    };
+    if (operands.size() == 2 && isFeature(operands[0])) {
+        appendRangeExpression(out, names, operands[0][0].value(), operators[0], operands[1]);
+        return true;
+    }
+    if (operands.size() == 2 && isFeature(operands[1])) {
+        appendRangeExpression(out, names, operands[1][0].value(), reversed(operators[0]), operands[0]);
+        return true;
+    }
+    if (operands.size() == 3 && isFeature(operands[1])) {
+        appendRangeExpression(out, names, operands[1][0].value(), reversed(operators[0]), operands[0]);
+        appendRangeExpression(out, names, operands[1][0].value(), operators[1], operands[2]);
+        return true;
+    }
+    return false;
+}
+
+static bool rewriteRangeSyntax(CSSParserTokenRange range, Vector<CSSParserToken>& out, Vector<String>& names)
+{
+    bool changed = false;
+    names.reserveCapacity(64);
+    names.append(ASCIILiteral("and"));
+    while (!range.atEnd()) {
+        const CSSParserToken& token = range.peek();
+        if (token.type() != LeftParenthesisToken) {
+            out.append(range.consume());
+            continue;
+        }
+        // A group with no blocks inside: try it as range syntax.
+        CSSParserTokenRange block = range;
+        CSSParserTokenRange contents = block.consumeBlock();
+        Vector<CSSParserToken> group;
+        bool simple = true;
+        CSSParserTokenRange scan = contents;
+        while (!scan.atEnd()) {
+            const CSSParserToken& inner = scan.consume();
+            if (inner.getBlockType() != CSSParserToken::NotBlock) {
+                simple = false;
+                break;
+            }
+            if (inner.type() != WhitespaceToken)
+                group.append(inner);
+        }
+        if (simple && names.size() + 4 < names.capacity() && rewriteRangeGroup(group, out, names)) {
+            changed = true;
+            range = block;
+            continue;
+        }
+        out.append(range.consume());
+    }
+    return changed;
+}
+
 RefPtr<MediaQuerySet> MediaQueryParser::parseInternal(CSSParserTokenRange range)
 {
+    Vector<CSSParserToken> rewritten;
+    Vector<String> names;
+    if (rewriteRangeSyntax(range, rewritten, names))
+        range = CSSParserTokenRange(rewritten);
+
     while (!range.atEnd())
         processToken(range.consume());
 
