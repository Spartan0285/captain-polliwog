diff --git a/Source/JavaScriptCore/jit/FPRInfo.h b/Source/JavaScriptCore/jit/FPRInfo.h
index ec0ab125..0b499acc 100644
--- a/Source/JavaScriptCore/jit/FPRInfo.h
+++ b/Source/JavaScriptCore/jit/FPRInfo.h
@@ -349,6 +349,64 @@ public:
 
 #endif // CPU(MIPS)
 
+#if CPU(PPC)
+
+// Darwin PowerPC: f0 is the MacroAssembler's scratch register, f1-f13 are
+// volatile and pass arguments (f1 and f2 return a double).
+class FPRInfo {
+public:
+    typedef FPRReg RegisterType;
+    static const unsigned numberOfRegisters = 7;
+
+    // Temporary registers.
+    static const FPRReg fpRegT0 = PPCRegisters::f1;
+    static const FPRReg fpRegT1 = PPCRegisters::f2;
+    static const FPRReg fpRegT2 = PPCRegisters::f3;
+    static const FPRReg fpRegT3 = PPCRegisters::f4;
+    static const FPRReg fpRegT4 = PPCRegisters::f5;
+    static const FPRReg fpRegT5 = PPCRegisters::f6;
+    static const FPRReg fpRegT6 = PPCRegisters::f7;
+
+    static const FPRReg returnValueFPR = PPCRegisters::f1;
+
+    static const FPRReg argumentFPR0 = PPCRegisters::f1;
+    static const FPRReg argumentFPR1 = PPCRegisters::f2;
+
+    static FPRReg toRegister(unsigned index)
+    {
+        static const FPRReg registerForIndex[numberOfRegisters] = {
+            fpRegT0, fpRegT1, fpRegT2, fpRegT3, fpRegT4, fpRegT5, fpRegT6 };
+
+        ASSERT(index < numberOfRegisters);
+        return registerForIndex[index];
+    }
+
+    static unsigned toIndex(FPRReg reg)
+    {
+        ASSERT(reg != InvalidFPRReg);
+        if (reg < PPCRegisters::f1 || reg > PPCRegisters::f7)
+            return InvalidIndex;
+        return reg - PPCRegisters::f1;
+    }
+
+    static const char* debugName(FPRReg reg)
+    {
+        ASSERT(reg != InvalidFPRReg);
+        ASSERT(reg < 32);
+        static const char* nameForRegister[32] = {
+            "f0", "f1", "f2", "f3", "f4", "f5", "f6", "f7",
+            "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15",
+            "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23",
+            "f24", "f25", "f26", "f27", "f28", "f29", "f30", "f31"
+        };
+        return nameForRegister[reg];
+    }
+
+    static const unsigned InvalidIndex = 0xffffffff;
+};
+
+#endif // CPU(PPC)
+
 #endif // ENABLE(JIT)
 
 } // namespace JSC
