+        when "t0", "a0", "r0"
+            "r3"
+        when "t1", "a1", "r1"
+            "r4"
+        when "t2", "a2"
+            "r5"
+        when "t3", "a3"
+            "r6"
+        when "t4"
+            "r7"
+        when "t5"
+            "r8"
+        when "cfr"
+            "r13"
+        when "sp"
+            "r1"
+        when "lr"
+            "lr"
+        else
+            raise "Bad register #{name} for PPC at #{codeOriginString}"
+        end
+    end
+end
+
+class FPRegisterID
+    def ppcOperand
+        case name
+        when "ft0", "fa0", "fr"
+            "f1"
+        when "ft1", "fa1"
+            "f2"
+        when "ft2"
+            "f3"
+        when "ft3"
+            "f4"
+        when "ft4"
+            "f5"
+        when "ft5"
+            "f6"
+        else
+            raise "Bad register #{name} for PPC at #{codeOriginString}"
+        end
+    end
+end
+
+class Immediate
+    def ppcOperand
+        raise "Invalid immediate #{value} at #{codeOriginString}" unless ppcFitsSigned16(value)
+        "#{value}"
+    end
+end
+
+class Address
+    def ppcOperand
+        raise "Bad offset #{offset.value} at #{codeOriginString}" unless ppcFitsSigned16(offset.value)
+        "#{offset.value}(#{base.ppcOperand})"
+    end
+end
+
+class BaseIndex
+    # Only the X-form: base + index, no scale, no offset.
+    def ppcOperand
+        raise "Malformed BaseIndex at #{codeOriginString}" unless scaleShift == 0 and offset.value == 0
+        "#{base.ppcOperand}, #{index.ppcOperand}"
+    end
+end
+
+class AbsoluteAddress
+    def ppcOperand
+        raise "Unconverted absolute address at #{codeOriginString}"
+    end
+end
+
+class LocalLabelReference
+    def register?
