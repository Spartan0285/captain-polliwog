+
+# 32-bit PowerPC, Darwin ABI, big-endian, for Apple's assembler (cctools).
+#
+# GPR conventions, to match the baseline JIT (jit/GPRInfo.h):
+#
+#  r3 => t0, a0, r0
+#  r4 => t1, a1, r1
+#  r5 => t2, a2
+#  r6 => t3, a3
+#  r7 => t4       (the LLInt PC; caller-saved, as on MIPS)
+#  r8 => t5
+#  r9, r10, r11, r12, r2 => temporaries for the lowering passes
+#  r13 => cfr     (callee-save in the C ABI; saved on VM entry)
+#  r1 => sp
+#  r0 => scratch used only inside single emitted sequences. It is never a
+#        base register: as rA of a load, store or addi it reads as zero.
+#  lr => lr       (moved through r0: mflr/mtlr)
+#
+# FPR conventions:
+#
+#  f1 => ft0, fa0, fr
+#  f2 => ft1, fa1
+#  f3 => ft2
+#  f4 => ft3
+#  f5 => ft4
+#  f6 => ft5
+#  f7, f8 => temporaries
+#  f0, f13 => scratch inside single emitted sequences
+#
+# Only cr0 is used, which is volatile in the ABI, as are f0-f13 and r0-r12.
+#
+# Integer <-> double conversions go through the red zone below the stack
+# pointer (224 bytes on Darwin), which signal handlers leave alone.
+
+class SpecialRegister
+    def ppcOperand
+        @name
+    end
+end
+
+PPC_TEMP_GPRS = [SpecialRegister.new("r9"), SpecialRegister.new("r10"), SpecialRegister.new("r11"),
+                 SpecialRegister.new("r12"), SpecialRegister.new("r2")]
+PPC_TEMP_FPRS = [SpecialRegister.new("f7"), SpecialRegister.new("f8")]
+
+def ppcFitsSigned16(value)
+    value.is_a? Integer and value >= -0x8000 and value <= 0x7fff
+end
+
+def ppcFitsUnsigned16(value)
+    value.is_a? Integer and value >= 0 and value <= 0xffff
+end
+
+def ppcSigned32(value)
+    value &= 0xffffffff
+    value >= 0x80000000 ? value - 0x100000000 : value
+end
+
+def ppcSigned16(value)
+    value &= 0xffff
+    value >= 0x8000 ? value - 0x10000 : value
+end
+
+def ppcMoveImmediate(value, register)
+    raise "Non-integer immediate #{value}" unless value.is_a? Integer
+    value = ppcSigned32(value)
+    if ppcFitsSigned16(value)
+        $asm.puts "li #{register}, #{value}"
+    else
+        $asm.puts "lis #{register}, #{ppcSigned16(value >> 16)}"
+        if (value & 0xffff) != 0
+            $asm.puts "ori #{register}, #{register}, #{value & 0xffff}"
+        end
+    end
+end
+
+class RegisterID
+    def ppcOperand
