+                op = $1.sub(/p$/, "i")
+                operands = node.operands
+                # result = first OP second: baddio a, b, d is d = a + b and
+                # bsubio a, b, d is d = a - b; baddio a, b is b = b + a and
+                # bsubio a, b is b = b - a.
+                label = operands[-1]
+                if operands.size == 4
+                    source = operands[1]
+                    target = operands[0]
+                    destination = operands[2]
+                else
+                    source = operands[0]
+                    target = operands[1]
+                    destination = operands[1]
+                end
+
+                # A memory destination: load, operate, store back.
+                address = nil
+                if destination.address?
+                    address = destination
+                    loaded = Tmp.new(node.codeOrigin, :gpr)
+                    newList << Instruction.new(node.codeOrigin, "loadi", [address, loaded], annotation)
+                    target = loaded if target == address
+                    destination = loaded
+                end
+                if target.address?
+                    loaded = Tmp.new(node.codeOrigin, :gpr)
+                    newList << Instruction.new(node.codeOrigin, "loadi", [target, loaded], annotation)
+                    target = loaded
+                end
+                if source.address?
+                    loaded = Tmp.new(node.codeOrigin, :gpr)
+                    newList << Instruction.new(node.codeOrigin, "loadi", [source, loaded], annotation)
+                    source = loaded
+                end
+
+                if condition == "o"
+                    raise "No overflow branch for #{node.opcode}" if op == "ori"
+                    result = Tmp.new(node.codeOrigin, :gpr)
+                    t1 = Tmp.new(node.codeOrigin, :gpr)
+                    t2 = Tmp.new(node.codeOrigin, :gpr)
+                    newList << Instruction.new(node.codeOrigin, op, [target, source, result], annotation)
+                    if op == "addi"
+                        newList << Instruction.new(node.codeOrigin, "xori", [result, target, t1])
+                        newList << Instruction.new(node.codeOrigin, "xori", [result, source, t2])
+                    else
+                        # result = target - source; overflow iff target and source differ
+                        # in sign and the result's sign differs from target's.
+                        newList << Instruction.new(node.codeOrigin, "xori", [target, source, t1])
+                        newList << Instruction.new(node.codeOrigin, "xori", [target, result, t2])
+                    end
+                    newList << Instruction.new(node.codeOrigin, "andi", [t1, t2])
+                    if address
+                        # Store even on overflow: the caller branches away anyway.
+                        newList << Instruction.new(node.codeOrigin, "move", [result, destination])
+                        newList << Instruction.new(node.codeOrigin, "storei", [destination, address])
+                        newList << Instruction.new(node.codeOrigin, "bilt", [t2, Immediate.new(node.codeOrigin, 0), label])
+                    else
+                        newList << Instruction.new(node.codeOrigin, "bilt", [t2, Immediate.new(node.codeOrigin, 0), label])
+                        newList << Instruction.new(node.codeOrigin, "move", [result, destination])
+                    end
+                else
+                    newList << Instruction.new(node.codeOrigin, op, [target, source, destination], annotation)
+                    if address
+                        newList << Instruction.new(node.codeOrigin, "storei", [destination, address])
+                    end
+                    branch = case condition
+                             when "s" then "bilt"
+                             when "z" then "bieq"
+                             when "nz" then "bineq"
+                             end
+                    newList << Instruction.new(node.codeOrigin, branch, [destination, Immediate.new(node.codeOrigin, 0), label])
+                end
+            else
+                newList << node
+            end
+        else
+            newList << node
+        end
+    }
+    newList
+end
+
+#
+# Actual lowering code follows.
+#
+
+class Sequence
+    def getModifiedListPPC
+        result = @list
+
+        result.each {
+            | node |
+            unless node.is_a? Instruction or
+                    node.is_a? Label or
+                    node.is_a? LocalLabel or
+                    node.is_a? Skip
+                raise "Unexpected #{node.inspect} at #{node.codeOrigin}"
+            end
+        }
+
+        result = ppcLowerSimpleBranchOps(result)
+        result = riscLowerSimpleBranchOps(result)
+        result = riscLowerHardBranchOps(result)
+        result = riscLowerShiftOps(result)
+        result = riscLowerMalformedAddresses(result) {
+            | node, address |
+            if address.is_a? BaseIndex
+                if node.is_a? Instruction and (node.opcode == "leap" or node.opcode == "leai")
+                    address.offset.value == 0
+                else
+                    address.scaleShift == 0 and address.offset.value == 0
+                end
+            elsif address.is_a? Address
+                ppcFitsSigned16(address.offset.value)
+            else
+                false
+            end
+        }
+        result = riscLowerMalformedAddressesDouble(result)
+        result = riscLowerMisplacedImmediates(result, ["storeb", "storeh", "storei", "storep"])
+        result = riscLowerMisplacedAddresses(result)
+        result = riscLowerRegisterReuse(result)
+        result = assignRegistersToTemporaries(result, :gpr, PPC_TEMP_GPRS)
+        result = assignRegistersToTemporaries(result, :fpr, PPC_TEMP_FPRS)
+        return result
+    end
+end
+
+def ppcOperands(operands)
+    operands.map{|v| v.ppcOperand}.join(", ")
+end
+
+# An operand for a register-or-immediate instruction: the register, or the
+# immediate put in r0 when it doesn't fit the instruction's immediate form.
+def ppcRegister(operand)
+    if operand.immediate?
+        ppcMoveImmediate(operand.value, "r0")
+        "r0"
+    else
+        operand.ppcOperand
+    end
+end
+
+# The three operands of an arithmetic instruction: (a, b, destination),
+# meaning destination = b OP a (and b = b OP a with two operands).
+def ppcArithOperands(operands)
+    if operands.size == 3
+        [operands[0], operands[1], operands[2]]
+    else
+        raise "Expected 2 or 3 operands" unless operands.size == 2
+        [operands[0], operands[1], operands[1]]
+    end
+end
+
+def emitPPCAdd(operands)
+    a, b, d = ppcArithOperands(operands)
+    a, b = b, a if b.immediate?
+    raise "Both operands immediate" if b.immediate?
+    if a.immediate?
+        value = ppcSigned32(a.value)
+        if value == 0
+            $asm.puts "mr #{d.ppcOperand}, #{b.ppcOperand}" unless d == b
+        elsif ppcFitsSigned16(value)
+            $asm.puts "addi #{d.ppcOperand}, #{b.ppcOperand}, #{value}"
+        elsif (value & 0xffff) == 0
+            $asm.puts "addis #{d.ppcOperand}, #{b.ppcOperand}, #{ppcSigned16(value >> 16)}"
+        else
+            $asm.puts "addis #{d.ppcOperand}, #{b.ppcOperand}, #{ppcSigned16((value + 0x8000) >> 16)}"
+            $asm.puts "addi #{d.ppcOperand}, #{d.ppcOperand}, #{ppcSigned16(value)}"
+        end
+    else
+        $asm.puts "add #{d.ppcOperand}, #{b.ppcOperand}, #{a.ppcOperand}"
+    end
+end
+
+# subi a, b (b = b - a), or subi a, b, d (d = a - b), as on ARM.
+def emitPPCSub(operands)
+    if operands.size == 3
+        m, s, d = operands[0], operands[1], operands[2]
+    else
+        m, s, d = operands[1], operands[0], operands[1]
+    end
+    if s.immediate?
+        emitPPCAdd([Immediate.new(s.codeOrigin, -ppcSigned32(s.value)), m, d])
+    elsif m.immediate?
+        if ppcFitsSigned16(ppcSigned32(m.value))
+            $asm.puts "subfic #{d.ppcOperand}, #{s.ppcOperand}, #{ppcSigned32(m.value)}"
+        else
+            $asm.puts "subf #{d.ppcOperand}, #{s.ppcOperand}, #{ppcRegister(m)}"
+        end
+    else
+        # subf d, s, m is d = m - s.
+        $asm.puts "subf #{d.ppcOperand}, #{s.ppcOperand}, #{m.ppcOperand}"
+    end
+end
+
+# and/or/xor, which have unsigned 16-bit immediate forms for either half.
+def emitPPCLogical(opcode, operands)
+    a, b, d = ppcArithOperands(operands)
+    a, b = b, a if b.immediate?
+    raise "Both operands immediate" if b.immediate?
+    if a.immediate?
+        value = a.value & 0xffffffff
+        low = value & 0xffff
+        high = value >> 16
+        case opcode
+        when "and"
+            if high == 0
+                $asm.puts "andi. #{d.ppcOperand}, #{b.ppcOperand}, #{low}"
+            elsif low == 0
+                $asm.puts "andis. #{d.ppcOperand}, #{b.ppcOperand}, #{high}"
+            else
+                ppcMoveImmediate(value, "r0")
+                $asm.puts "and #{d.ppcOperand}, #{b.ppcOperand}, r0"
+            end
+        else
+            if high == 0
+                $asm.puts "#{opcode}i #{d.ppcOperand}, #{b.ppcOperand}, #{low}"
+            elsif low == 0
+                $asm.puts "#{opcode}is #{d.ppcOperand}, #{b.ppcOperand}, #{high}"
+            else
+                $asm.puts "#{opcode}is #{d.ppcOperand}, #{b.ppcOperand}, #{high}"
+                $asm.puts "#{opcode}i #{d.ppcOperand}, #{d.ppcOperand}, #{low}"
+            end
+        end
+    else
+        $asm.puts "#{opcode} #{d.ppcOperand}, #{b.ppcOperand}, #{a.ppcOperand}"
+    end
+end
+
+def emitPPCMul(operands)
+    a, b, d = ppcArithOperands(operands)
+    a, b = b, a if b.immediate?
+    if a.immediate? and ppcFitsSigned16(ppcSigned32(a.value))
+        $asm.puts "mulli #{d.ppcOperand}, #{b.ppcOperand}, #{ppcSigned32(a.value)}"
+    else
+        $asm.puts "mullw #{d.ppcOperand}, #{b.ppcOperand}, #{ppcRegister(a)}"
+    end
+end
+
+# lshifti amount, value (value <<= amount), or
+# lshifti value, amount, destination (destination = value << amount).
+def emitPPCShift(kind, operands)
+    if operands.size == 3
+        b, a, d = operands[0], operands[1], operands[2]
+    else
+        a, b, d = operands[0], operands[1], operands[1]
+    end
+    raise "Shifting an immediate" if b.immediate?
+    if a.immediate?
+        amount = a.value & 31
+        if amount == 0
+            $asm.puts "mr #{d.ppcOperand}, #{b.ppcOperand}" unless d == b
+            return
+        end
+        case kind
+        when "left"
+            $asm.puts "slwi #{d.ppcOperand}, #{b.ppcOperand}, #{amount}"
+        when "arithmetic"
+            $asm.puts "srawi #{d.ppcOperand}, #{b.ppcOperand}, #{amount}"
+        when "logical"
+            $asm.puts "srwi #{d.ppcOperand}, #{b.ppcOperand}, #{amount}"
+        end
+    else
+        # The amount was masked to 0..31 by riscLowerShiftOps; PowerPC's
+        # shifts would otherwise honour a sixth bit.
+        opcode = { "left" => "slw", "arithmetic" => "sraw", "logical" => "srw" }[kind]
+        $asm.puts "#{opcode} #{d.ppcOperand}, #{b.ppcOperand}, #{a.ppcOperand}"
+    end
+end
+
+def emitPPCMove(source, destination)
+    if destination.is_a? RegisterID and destination.name == "lr"
+        if source.immediate?
+            ppcMoveImmediate(source.value, "r0")
+            $asm.puts "mtlr r0"
+        else
+            $asm.puts "mtlr #{source.ppcOperand}"
+        end
+    elsif source.is_a? RegisterID and source.name == "lr"
+        $asm.puts "mflr #{destination.ppcOperand}"
+    elsif source.immediate?
+        ppcMoveImmediate(source.value, destination.ppcOperand)
+    elsif source != destination
+        $asm.puts "mr #{destination.ppcOperand}, #{source.ppcOperand}"
+    end
+end
+
+def ppcIsLR(operand)
+    operand.is_a? RegisterID and operand.name == "lr"
+end
+
+# Loads: opcode and its X-form (register + register) counterpart.
+def emitPPCLoad(dform, xform, address, destination, extend = nil)
+    target = ppcIsLR(destination) ? "r0" : destination.ppcOperand
+    if address.is_a? BaseIndex
+        $asm.puts "#{xform} #{target}, #{address.ppcOperand}"
+    else
+        $asm.puts "#{dform} #{target}, #{address.ppcOperand}"
+    end
+    $asm.puts "#{extend} #{target}, #{target}" if extend
+    $asm.puts "mtlr r0" if ppcIsLR(destination)
+end
+
+def emitPPCStore(dform, xform, source, address)
+    if ppcIsLR(source)
+        $asm.puts "mflr r0"
+        value = "r0"
+    else
+        value = source.ppcOperand
+    end
+    if address.is_a? BaseIndex
+        $asm.puts "#{xform} #{value}, #{address.ppcOperand}"
+    else
+        $asm.puts "#{dform} #{value}, #{address.ppcOperand}"
+    end
+end
+
+$ppcInvertedCondition = {
+    "eq" => "ne", "ne" => "eq", "lt" => "ge", "ge" => "lt", "gt" => "le", "le" => "gt"
+}
+
+# A conditional branch on cr0. Conditional branches reach +-32KB, so one to
+# a global label (anywhere in the interpreter) jumps around an unconditional
+# branch, which reaches +-32MB.
+def emitPPCBranch(condition, label)
+    if label.is_a? LocalLabelReference
+        $asm.puts "b#{condition} #{label.asmLabel}"
+    else
+        skip = LocalLabel.unique("ppcbranch")
+        $asm.puts "b#{$ppcInvertedCondition[condition]} #{LocalLabelReference.new(codeOrigin, skip).asmLabel}"
+        $asm.puts "b #{label.asmLabel}"
+        skip.lower("PPC")
+    end
+end
+
+# Compare a with b into cr0; returns the condition possibly flipped if the
+# operands had to be swapped.
+$ppcSwappedCondition = {
+    "eq" => "eq", "ne" => "ne", "lt" => "gt", "gt" => "lt", "le" => "ge", "ge" => "le"
+}
+
+def emitPPCCompare(a, b, condition, unsigned)
+    if a.immediate? and not b.immediate?
+        a, b = b, a
+        condition = $ppcSwappedCondition[condition]
+    end
+    raise "Comparing two immediates" if a.immediate?
+    compare = unsigned ? "cmplw" : "cmpw"
+    if b.immediate?
+        value = unsigned ? (b.value & 0xffffffff) : ppcSigned32(b.value)
+        if (unsigned and ppcFitsUnsigned16(value)) or (not unsigned and ppcFitsSigned16(value))
+            $asm.puts "#{compare}i cr0, #{a.ppcOperand}, #{value}"
+        else
+            ppcMoveImmediate(b.value, "r0")
+            $asm.puts "#{compare} cr0, #{a.ppcOperand}, r0"
+        end
+    else
+        $asm.puts "#{compare} cr0, #{a.ppcOperand}, #{b.ppcOperand}"
+    end
+    condition
+end
+
+# Sets cr0 from value & mask: eq when zero, lt when negative. operands is
+# [value] or [value, mask].
+def emitPPCTest(operands)
+    value = operands[0]
+    mask = operands.size > 1 ? operands[1] : nil
+    if mask.nil? or (mask.immediate? and ppcSigned32(mask.value) == -1)
+        $asm.puts "cmpwi cr0, #{value.ppcOperand}, 0"
+    elsif mask.immediate?
+        bits = mask.value & 0xffffffff
+        if (bits >> 16) == 0
+            $asm.puts "andi. r0, #{value.ppcOperand}, #{bits}"
+        elsif (bits & 0xffff) == 0
+            $asm.puts "andis. r0, #{value.ppcOperand}, #{bits >> 16}"
+        else
+            ppcMoveImmediate(bits, "r0")
+            $asm.puts "and. r0, #{value.ppcOperand}, r0"
+        end
+    else
+        $asm.puts "and. r0, #{value.ppcOperand}, #{mask.ppcOperand}"
+    end
+end
+
+# destination = condition on cr0 ? 1 : 0
+def emitPPCSetFromCondition(condition, destination)
+    done = LocalLabel.unique("ppcset")
+    $asm.puts "li #{destination.ppcOperand}, 1"
+    $asm.puts "b#{condition} #{LocalLabelReference.new(codeOrigin, done).asmLabel}"
+    $asm.puts "li #{destination.ppcOperand}, 0"
+    done.lower("PPC")
+end
+
+# Double comparison branches: fcmpu sets lt, gt, eq or un (bit 3) in cr0.
+def emitPPCDoubleBranch(operands, orBits, condition)
+    $asm.puts "fcmpu cr0, #{operands[0].ppcOperand}, #{operands[1].ppcOperand}"
+    orBits.each {
+        | pair |
+        $asm.puts "cror #{pair[0]}, #{pair[0]}, #{pair[1]}"
+    }
+    emitPPCBranch(condition, operands[2])
+end
+
+# Converts the int in gpr to a double in fpr (no fcfid on 32-bit PowerPC):
+# the double with high word 0x43300000 and low word (x ^ 0x80000000) is
+# 2^52 + 2^31 + x.
+def emitPPCIntToDouble(gpr, fpr)
+    $asm.puts "lis r0, 0x4330"
+    $asm.puts "stw r0, -8(r1)"
+    $asm.puts "xoris r0, #{gpr}, 0x8000"
+    $asm.puts "stw r0, -4(r1)"
+    $asm.puts "lfd #{fpr}, -8(r1)"
+    $asm.puts "lis r0, 0x4330"
+    $asm.puts "stw r0, -16(r1)"
+    $asm.puts "lis r0, -32768"
+    $asm.puts "stw r0, -12(r1)"
+    $asm.puts "lfd f13, -16(r1)"
+    $asm.puts "fsub #{fpr}, #{fpr}, f13"
+end
+
+def emitPPCDoubleToInt(fpr, gpr)
+    $asm.puts "fctiwz f0, #{fpr}"
+    $asm.puts "stfd f0, -8(r1)"
+    $asm.puts "lwz #{gpr}, -4(r1)"
+end
+
+def emitPPCDoubleArith(opcode, operands)
+    if operands.size == 3
+        $asm.puts "#{opcode} #{operands[2].ppcOperand}, #{operands[0].ppcOperand}, #{operands[1].ppcOperand}"
+    else
+        $asm.puts "#{opcode} #{operands[1].ppcOperand}, #{operands[1].ppcOperand}, #{operands[0].ppcOperand}"
+    end
+end
+
+class Address
+    def ppcEmitLea(destination)
+        emitPPCAdd([Immediate.new(codeOrigin, offset.value), base, destination])
+    end
+end
+
+class BaseIndex
+    def ppcEmitLea(destination)
+        if scaleShift == 0
+            $asm.puts "add #{destination.ppcOperand}, #{base.ppcOperand}, #{index.ppcOperand}"
+        else
+            $asm.puts "slwi r0, #{index.ppcOperand}, #{scaleShift}"
+            $asm.puts "add #{destination.ppcOperand}, #{base.ppcOperand}, r0"
+        end
+        if offset.value != 0
+            emitPPCAdd([Immediate.new(codeOrigin, offset.value), destination, destination])
+        end
+    end
+end
+
+class Instruction
+    def lowerPPC
+        $asm.codeOrigin codeOriginString if $enableCodeOriginComments
+        $asm.annotation annotation if $enableInstrAnnotations
+
+        case opcode
+        when "addi", "addp", "addis", "addps"
+            emitPPCAdd(operands)
+        when "subi", "subp", "subis"
+            emitPPCSub(operands)
+        when "andi", "andp"
+            emitPPCLogical("and", operands)
+        when "ori", "orp", "oris"
+            emitPPCLogical("or", operands)
+        when "xori", "xorp"
+            emitPPCLogical("xor", operands)
+        when "muli", "mulp"
+            emitPPCMul(operands)
+        when "lshifti", "lshiftp"
+            emitPPCShift("left", operands)
+        when "rshifti", "rshiftp"
+            emitPPCShift("arithmetic", operands)
+        when "urshifti", "urshiftp"
+            emitPPCShift("logical", operands)
+        when "negi", "negp"
+            $asm.puts "neg #{operands[0].ppcOperand}, #{operands[0].ppcOperand}"
+        when "noti"
+            $asm.puts "not #{operands[0].ppcOperand}, #{operands[0].ppcOperand}"
+        when "loadi", "loadis", "loadp"
+            emitPPCLoad("lwz", "lwzx", operands[0], operands[1])
+        when "storei", "storep"
+            emitPPCStore("stw", "stwx", operands[0], operands[1])
+        when "loadb"
+            emitPPCLoad("lbz", "lbzx", operands[0], operands[1])
+        when "loadbs"
+            emitPPCLoad("lbz", "lbzx", operands[0], operands[1], "extsb")
+        when "storeb"
+            emitPPCStore("stb", "stbx", operands[0], operands[1])
+        when "loadh"
+            emitPPCLoad("lhz", "lhzx", operands[0], operands[1])
+        when "loadhs"
+            emitPPCLoad("lha", "lhax", operands[0], operands[1])
+        when "storeh"
+            emitPPCStore("sth", "sthx", operands[0], operands[1])
+        when "loadd"
+            if operands[0].is_a? BaseIndex
+                $asm.puts "lfdx #{operands[1].ppcOperand}, #{operands[0].ppcOperand}"
+            else
+                $asm.puts "lfd #{operands[1].ppcOperand}, #{operands[0].ppcOperand}"
+            end
+        when "stored"
+            if operands[1].is_a? BaseIndex
+                $asm.puts "stfdx #{operands[0].ppcOperand}, #{operands[1].ppcOperand}"
+            else
+                $asm.puts "stfd #{operands[0].ppcOperand}, #{operands[1].ppcOperand}"
+            end
+        when "moved"
+            $asm.puts "fmr #{operands[1].ppcOperand}, #{operands[0].ppcOperand}"
+        when "addd"
+            emitPPCDoubleArith("fadd", operands)
+        when "subd"
+            emitPPCDoubleArith("fsub", operands)
+        when "muld"
+            emitPPCDoubleArith("fmul", operands)
+        when "divd"
+            emitPPCDoubleArith("fdiv", operands)
+        when "sqrtd"
+            raise "The G3 and G4 have no fsqrt, at #{codeOriginString}"
+        when "ci2d"
+            emitPPCIntToDouble(operands[0].ppcOperand, operands[1].ppcOperand)
+        when "td2i"
+            emitPPCDoubleToInt(operands[0].ppcOperand, operands[1].ppcOperand)
+        when "bcd2i"
+            # Branch unless the double is exactly an int32 (and not -0).
+            emitPPCDoubleToInt(operands[0].ppcOperand, operands[1].ppcOperand)
+            emitPPCIntToDouble(operands[1].ppcOperand, "f0")
+            $asm.puts "fcmpu cr0, f0, #{operands[0].ppcOperand}"
+            emitPPCBranch("ne", operands[2])
+            $asm.puts "cmpwi cr0, #{operands[1].ppcOperand}, 0"
+            emitPPCBranch("eq", operands[2])
+        when "btd2i", "movdz"
+            raise "PPC does not support #{opcode}, at #{codeOriginString}"
+        when "fii2d"
+            # fii2d lowWord, highWord, fpr
+            $asm.puts "stw #{operands[1].ppcOperand}, -8(r1)"
+            $asm.puts "stw #{operands[0].ppcOperand}, -4(r1)"
+            $asm.puts "lfd #{operands[2].ppcOperand}, -8(r1)"
+        when "fd2ii"
+            # fd2ii fpr, lowWord, highWord
+            $asm.puts "stfd #{operands[0].ppcOperand}, -8(r1)"
+            $asm.puts "lwz #{operands[1].ppcOperand}, -4(r1)"
+            $asm.puts "lwz #{operands[2].ppcOperand}, -8(r1)"
+        when "bdeq"
+            emitPPCDoubleBranch(operands, [], "eq")
+        when "bdneq"
+            emitPPCDoubleBranch(operands, [[2, 3]], "ne")
+        when "bdgt"
+            emitPPCDoubleBranch(operands, [], "gt")
+        when "bdgteq"
+            emitPPCDoubleBranch(operands, [[2, 1]], "eq")
+        when "bdlt"
+            emitPPCDoubleBranch(operands, [], "lt")
+        when "bdlteq"
+            emitPPCDoubleBranch(operands, [[2, 0]], "eq")
+        when "bdequn"
+            emitPPCDoubleBranch(operands, [[2, 3]], "eq")
+        when "bdnequn"
+            emitPPCDoubleBranch(operands, [], "ne")
+        when "bdgtun"
+            emitPPCDoubleBranch(operands, [[1, 3]], "gt")
+        when "bdgtequn"
+            emitPPCDoubleBranch(operands, [], "ge")
+        when "bdltun"
+            emitPPCDoubleBranch(operands, [[0, 3]], "lt")
+        when "bdltequn"
+            emitPPCDoubleBranch(operands, [], "le")
+        when "pop"
+            operands.each {
+                | op |
+                if ppcIsLR(op)
+                    $asm.puts "lwz r0, 0(r1)"
+                    $asm.puts "addi r1, r1, 4"
+                    $asm.puts "mtlr r0"
+                else
+                    $asm.puts "lwz #{op.ppcOperand}, 0(r1)"
+                    $asm.puts "addi r1, r1, 4"
+                end
+            }
+        when "push"
+            operands.each {
+                | op |
+                if ppcIsLR(op)
+                    $asm.puts "mflr r0"
+                    $asm.puts "stwu r0, -4(r1)"
+                else
+                    $asm.puts "stwu #{op.ppcOperand}, -4(r1)"
+                end
+            }
+        when "move"
+            emitPPCMove(operands[0], operands[1])
+        when "nop"
+            $asm.puts "nop"
+        when "bieq", "bpeq", "bbeq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "eq", false), operands[2])
+        when "bineq", "bpneq", "bbneq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "ne", false), operands[2])
+        when "bia", "bpa", "bba"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "gt", true), operands[2])
+        when "biaeq", "bpaeq", "bbaeq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "ge", true), operands[2])
+        when "bib", "bpb", "bbb"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "lt", true), operands[2])
+        when "bibeq", "bpbeq", "bbbeq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "le", true), operands[2])
+        when "bigt", "bpgt", "bbgt"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "gt", false), operands[2])
+        when "bigteq", "bpgteq", "bbgteq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "ge", false), operands[2])
+        when "bilt", "bplt", "bblt"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "lt", false), operands[2])
+        when "bilteq", "bplteq", "bblteq"
+            emitPPCBranch(emitPPCCompare(operands[0], operands[1], "le", false), operands[2])
+        when "btiz", "btpz", "btbz"
+            emitPPCTest(operands[0..-2])
+            emitPPCBranch("eq", operands[-1])
+        when "btinz", "btpnz", "btbnz"
+            emitPPCTest(operands[0..-2])
+            emitPPCBranch("ne", operands[-1])
+        when "btis", "btps", "btbs"
+            emitPPCTest(operands[0..-2])
+            emitPPCBranch("lt", operands[-1])
+        when "cieq", "cpeq", "cbeq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "eq", false), operands[2])
+        when "cineq", "cpneq", "cbneq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "ne", false), operands[2])
+        when "cia", "cpa", "cba"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "gt", true), operands[2])
+        when "ciaeq", "cpaeq", "cbaeq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "ge", true), operands[2])
+        when "cib", "cpb", "cbb"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "lt", true), operands[2])
+        when "cibeq", "cpbeq", "cbbeq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "le", true), operands[2])
+        when "cigt", "cpgt", "cbgt"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "gt", false), operands[2])
+        when "cigteq", "cpgteq", "cbgteq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "ge", false), operands[2])
+        when "cilt", "cplt", "cblt"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "lt", false), operands[2])
+        when "cilteq", "cplteq", "cblteq"
+            emitPPCSetFromCondition(emitPPCCompare(operands[0], operands[1], "le", false), operands[2])
+        when "tis", "tbs", "tps"
+            emitPPCTest(operands[0..-2])
+            emitPPCSetFromCondition("lt", operands[-1])
+        when "tiz", "tbz", "tpz"
+            emitPPCTest(operands[0..-2])
+            emitPPCSetFromCondition("eq", operands[-1])
+        when "tinz", "tbnz", "tpnz"
+            emitPPCTest(operands[0..-2])
+            emitPPCSetFromCondition("ne", operands[-1])
+        when "jmp"
+            if operands[0].label?
+                $asm.puts "b #{operands[0].asmLabel}"
+            else
+                $asm.puts "mtctr #{operands[0].ppcOperand}"
+                $asm.puts "bctr"
+            end
+        when "call"
+            if operands[0].label?
+                $asm.puts "bl #{operands[0].asmLabel}"
+            else
+                # Darwin passes the target of a call through a pointer in r12
+                # as well.
+                $asm.puts "mr r12, #{operands[0].ppcOperand}" unless operands[0].ppcOperand == "r12"
+                $asm.puts "mtctr r12"
+                $asm.puts "bctrl"
+            end
+        when "break"
+            $asm.puts "trap"
+        when "ret"
+            $asm.puts "blr"
+        when "peek"
+            $asm.puts "lwz #{operands[1].ppcOperand}, #{operands[0].value * 4}(r1)"
+        when "poke"
+            $asm.puts "stw #{operands[1].ppcOperand}, #{operands[0].value * 4}(r1)"
+        when "leai", "leap"
+            operands[0].ppcEmitLea(operands[1])
+        when "smulli"
+            raise "Wrong number of arguments to smulli at #{codeOriginString}" unless operands.length == 4
+            $asm.puts "mulhw r0, #{operands[0].ppcOperand}, #{ppcRegister(operands[1])}"
+            $asm.puts "mullw #{operands[2].ppcOperand}, #{operands[0].ppcOperand}, #{operands[1].ppcOperand}"
+            $asm.puts "mr #{operands[3].ppcOperand}, r0"
+        when "memfence"
+            $asm.puts "sync"
+        when "ppcbcl"
+            # The first half of finding the PC: save lr, branch-and-link to
+            # the next instruction, which is the label given.
+            $asm.puts "mflr r0"
+            $asm.puts "bcl 20, 31, #{operands[0].asmLabel}"
+        when "ppcpcfinish"
+            $asm.puts "mflr #{operands[0].ppcOperand}"
+            $asm.puts "mtlr r0"
+        when "ppclabeloffset"
+            # ppclabeloffset label, base, baseRegister, destination:
+            # destination = baseRegister + (label - base)
+            difference = "#{operands[0].asmLabel} - #{operands[1].asmLabel}"
+            $asm.puts "addis #{operands[3].ppcOperand}, #{operands[2].ppcOperand}, ha16(#{difference})"
+            $asm.puts "addi #{operands[3].ppcOperand}, #{operands[3].ppcOperand}, lo16(#{difference})"
+        else
+            lowerDefault
+        end
+    end
+end
