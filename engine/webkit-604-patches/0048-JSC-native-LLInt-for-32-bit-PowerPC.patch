+    end
+end
+
+#
+# Lowering of branches on the result of arithmetic. PowerPC's overflow bit
+# is sticky, so overflow is found from signs as MIPS does:
+#
+#   baddio a, b, label          (b = b + a; branch on signed overflow)
+#
+# becomes
+#
+#   addi a, b, tr
+#   xori tr, b, t1              # t1 = result ^ b
+#   xori tr, a, t2              # t2 = result ^ a
+#   andi t1, t2                 # negative iff both operands' signs differ from the result's
+#   bilt t2, 0, label
+#   move tr, b
+#
+# and baddiz a, b, label becomes addi a, b then bieq b, 0, label.
+#
