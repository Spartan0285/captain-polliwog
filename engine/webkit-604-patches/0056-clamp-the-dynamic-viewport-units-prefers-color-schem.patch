diff --git a/Source/WebCore/css/CSSCalculationValue.cpp b/Source/WebCore/css/CSSCalculationValue.cpp
index b7583010..5e4fde53 100644
--- a/Source/WebCore/css/CSSCalculationValue.cpp
+++ b/Source/WebCore/css/CSSCalculationValue.cpp
@@ -730,6 +730,8 @@ public:
             ok = parseValueExpression(tokens, 0, &result);
         else if (function == CSSValueMin || function == CSSValueMax)
             ok = parseMinMaxExpression(tokens, function, 0, &result);
+        else if (function == CSSValueClamp)
+            ok = parseClampExpression(tokens, 0, &result);
         if (!ok || !tokens.atEnd())
             return nullptr;
         return result.value;
@@ -783,6 +785,13 @@ private:
             innerRange.consumeWhitespace();
             return parseMinMaxExpression(innerRange, functionId, depth, result);
         }
+
+        if (functionId == CSSValueClamp) {
+            CSSParserTokenRange innerRange = tokens.consumeBlock();
+            tokens.consumeWhitespace();
+            innerRange.consumeWhitespace();
+            return parseClampExpression(innerRange, depth, result);
+        }
         
         return parseValue(tokens, result);
     }
@@ -875,6 +884,47 @@ private:
         return result->value;
     }
 
+    // clamp(minimum, preferred, maximum) is defined as
+    // max(minimum, min(preferred, maximum)), which is what it is built as:
+    // everything below this point already knows how to handle those.
+    bool parseClampExpression(CSSParserTokenRange& tokens, int depth, Value* result)
+    {
+        Value minimum, preferred, maximum;
+
+        if (checkDepthAndIndex(&depth, tokens) != OK)
+            return false;
+        if (!parseValueExpression(tokens, depth, &minimum))
+            return false;
+        tokens.consumeWhitespace();
+        if (tokens.consume().type() != CommaToken)
+            return false;
+        tokens.consumeWhitespace();
+        if (!parseValueExpression(tokens, depth, &preferred))
+            return false;
+        tokens.consumeWhitespace();
+        if (tokens.consume().type() != CommaToken)
+            return false;
+        tokens.consumeWhitespace();
+        if (!parseValueExpression(tokens, depth, &maximum))
+            return false;
+        tokens.consumeWhitespace();
+        if (!tokens.atEnd())
+            return false;
+
+        Vector<Ref<CSSCalcExpressionNode>> inner;
+        inner.append(preferred.value.releaseNonNull());
+        inner.append(maximum.value.releaseNonNull());
+        auto upperBounded = CSSCalcOperation::createMinOrMax(CalcMin, WTFMove(inner), m_destinationCategory);
+        if (!upperBounded)
+            return false;
+
+        Vector<Ref<CSSCalcExpressionNode>> outer;
+        outer.append(minimum.value.releaseNonNull());
+        outer.append(upperBounded.releaseNonNull());
+        result->value = CSSCalcOperation::createMinOrMax(CalcMax, WTFMove(outer), m_destinationCategory);
+        return result->value;
+    }
+
     bool parseValueExpression(CSSParserTokenRange& tokens, int depth, Value* result)
     {
         return parseAdditiveValueExpression(tokens, depth, result);
