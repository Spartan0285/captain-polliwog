     return value / fontSize;
 }
 
+// rem is the root element's font size, whatever this element's own is.
+ExceptionOr<float> SVGLengthContext::convertValueFromREMSToUserUnits(float value) const
+{
+    auto* style = m_context && m_context->document().documentElement()
+        ? m_context->document().documentElement()->renderStyle() : nullptr;
+    if (!style)
+        return Exception { NOT_SUPPORTED_ERR };
+
+    return value * style->computedFontPixelSize();
+}
+
+ExceptionOr<float> SVGLengthContext::convertValueFromUserUnitsToREMS(float value) const
+{
+    auto* style = m_context && m_context->document().documentElement()
+        ? m_context->document().documentElement()->renderStyle() : nullptr;
+    if (!style)
+        return Exception { NOT_SUPPORTED_ERR };
+
+    float fontSize = style->computedFontPixelSize();
+    if (!fontSize)
+        return Exception { NOT_SUPPORTED_ERR };
+
+    return value / fontSize;
+}
+
 ExceptionOr<float> SVGLengthContext::convertValueFromEMSToUserUnits(float value) const
 {
     auto* style = renderStyleForLengthResolving(m_context);
