From c8f738f75eb88f0021af3e21296218eacbd3892f Mon Sep 17 00:00:00 2001
From: Captain Polliwog build <build@captainpolliwog.invalid>
Date: Thu, 17 Sep 2026 23:51:42 -0400
Subject: [PATCH 02/54] CMake Mac port: allow building WebKitLegacy without
 WebKit2

POLLIWOG_ENABLE_WEBKIT2=OFF skips WebKit2 and WebGL, which need frameworks
Mac OS X 10.4/10.5 do not have.
---
 Source/cmake/OptionsMac.cmake | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/Source/cmake/OptionsMac.cmake b/Source/cmake/OptionsMac.cmake
index b92b1129..17f2d3ff 100644
--- a/Source/cmake/OptionsMac.cmake
+++ b/Source/cmake/OptionsMac.cmake
@@ -110,9 +110,16 @@ WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEMORY_SAMPLER PRIVATE ON)
 
 WEBKIT_OPTION_END()
 
-set(ENABLE_GRAPHICS_CONTEXT_3D ON)
+# Captain Polliwog builds for PowerPC Mac OS X, where only the single-process
+# WebKitLegacy is wanted (WebKit2 needs XPC, AVFoundation and other frameworks
+# 10.4/10.5 lack), and WebGL is off. Both can be forced back on from the
+# command line.
+if (NOT DEFINED POLLIWOG_ENABLE_WEBKIT2)
+    set(POLLIWOG_ENABLE_WEBKIT2 ON)
+endif ()
+set(ENABLE_GRAPHICS_CONTEXT_3D ${POLLIWOG_ENABLE_WEBKIT2})
 set(ENABLE_WEBKIT_LEGACY ON)
-set(ENABLE_WEBKIT ON)
+set(ENABLE_WEBKIT ${POLLIWOG_ENABLE_WEBKIT2})
 
 set(WebCore_LIBRARY_TYPE SHARED)
 set(WebCoreTestSupport_LIBRARY_TYPE SHARED)
