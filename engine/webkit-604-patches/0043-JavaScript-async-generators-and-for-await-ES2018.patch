+// Async generators (async function*), for an engine that predates them.
+//
+// The body of an async generator is compiled as a generator's is; both its
+// awaits and its yields suspend it. Before suspending at a yield the body
+// sets @asyncGeneratorYieldKind on the generator object: 1 for yield, 2 for
+// yield* (whose delegation is done here). These functions drive the body the
+// way @asyncFunctionResume drives an async function's, keeping a queue of
+// next/return/throw requests, each with its own promise.
+
+function next(value)
+{
+    "use strict";
+
+    return @asyncGeneratorEnqueue(this, value, @GeneratorResumeModeNormal);
+}
+
+function return(value)
+{
+    "use strict";
+
+    return @asyncGeneratorEnqueue(this, value, @GeneratorResumeModeReturn);
+}
+
+function throw(exception)
+{
+    "use strict";
+
+    return @asyncGeneratorEnqueue(this, exception, @GeneratorResumeModeThrow);
+}
+
+function symbolAsyncIteratorGetter()
+{
+    "use strict";
+
+    return this;
+}
+
+@globalPrivate
+function asyncGeneratorEnqueue(generator, value, resumeMode)
+{
+    "use strict";
+
+    let promiseCapability = @newPromiseCapability(@Promise);
+    if (!@isObject(generator) || typeof generator.@generatorState !== "number") {
+        promiseCapability.@reject.@call(@undefined, new @TypeError("|this| should be an async generator"));
+        return promiseCapability.@promise;
+    }
+
+    let request = { resumeMode: resumeMode, value: value, promiseCapability: promiseCapability, next: null };
+    let last = generator.@asyncGeneratorQueueLast;
+    if (last)
+        last.next = request;
+    else
+        generator.@asyncGeneratorQueueFirst = request;
+    generator.@asyncGeneratorQueueLast = request;
+
+    if (!generator.@asyncGeneratorRunning)
+        @asyncGeneratorResumeNext(generator);
+    return promiseCapability.@promise;
+}
+
+// Settles the oldest request: { value, done } or a rejection.
+@globalPrivate
+function asyncGeneratorSettle(generator, value, done, isRejection)
+{
+    "use strict";
+
+    let request = generator.@asyncGeneratorQueueFirst;
+    if (!request)
+        return;
+    generator.@asyncGeneratorQueueFirst = request.next;
+    if (!request.next)
+        generator.@asyncGeneratorQueueLast = null;
+    if (isRejection)
+        request.promiseCapability.@reject.@call(@undefined, value);
+    else
+        request.promiseCapability.@resolve.@call(@undefined, { value: value, done: done });
+}
+
+@globalPrivate
+function asyncGeneratorAwaitThen(value, onFulfilled, onRejected)
+{
+    "use strict";
+
+    let wrapped = @newPromiseCapability(@Promise);
+    wrapped.@resolve.@call(@undefined, value);
+    wrapped.@promise.@then(onFulfilled, onRejected);
+}
+
+// Serves the next queued request, unless the body is busy with one already.
+@globalPrivate
+function asyncGeneratorResumeNext(generator)
+{
+    "use strict";
+
+    while (true) {
+        if (generator.@asyncGeneratorRunning)
+            return;
+        let request = generator.@asyncGeneratorQueueFirst;
+        if (!request)
+            return;
+
+        if (generator.@asyncGeneratorDelegate) {
+            @asyncGeneratorResumeDelegate(generator, request.value, request.resumeMode);
+            return;
+        }
+
+        if (generator.@generatorState === @GeneratorStateCompleted) {
+            if (request.resumeMode === @GeneratorResumeModeNormal) {
+                @asyncGeneratorSettle(generator, @undefined, true, false);
+                continue;
+            }
+            if (request.resumeMode === @GeneratorResumeModeThrow) {
+                @asyncGeneratorSettle(generator, request.value, true, true);
+                continue;
+            }
+            generator.@asyncGeneratorRunning = true;
+            @asyncGeneratorAwaitThen(request.value,
+                function(value) {
+                    generator.@asyncGeneratorRunning = false;
+                    @asyncGeneratorSettle(generator, value, true, false);
+                    @asyncGeneratorResumeNext(generator);
+                },
+                function(error) {
+                    generator.@asyncGeneratorRunning = false;
+                    @asyncGeneratorSettle(generator, error, true, true);
+                    @asyncGeneratorResumeNext(generator);
+                });
+            return;
+        }
+
+        @asyncGeneratorStep(generator, request.value, request.resumeMode);
+        return;
+    }
+}
+
+// Runs the body until it awaits, yields or finishes.
+@globalPrivate
+function asyncGeneratorStep(generator, sentValue, resumeMode)
+{
+    "use strict";
+
+    let state = generator.@generatorState;
+    let value = @undefined;
+    generator.@asyncGeneratorRunning = true;
+    generator.@asyncGeneratorYieldKind = 0;
+    try {
+        generator.@generatorState = @GeneratorStateExecuting;
+        value = generator.@generatorNext.@call(generator.@generatorThis, generator, state, sentValue, resumeMode, generator.@generatorFrame);
+    } catch (error) {
+        generator.@generatorState = @GeneratorStateCompleted;
+        generator.@asyncGeneratorRunning = false;
+        @asyncGeneratorSettle(generator, error, true, true);
+        @asyncGeneratorResumeNext(generator);
+        return;
+    }
+
+    if (generator.@generatorState === @GeneratorStateExecuting) {
+        // Finished: its return value is awaited, then given as done.
+        generator.@generatorState = @GeneratorStateCompleted;
+        @asyncGeneratorAwaitThen(value,
+            function(result) {
+                generator.@asyncGeneratorRunning = false;
+                @asyncGeneratorSettle(generator, result, true, false);
+                @asyncGeneratorResumeNext(generator);
+            },
+            function(error) {
+                generator.@asyncGeneratorRunning = false;
+                @asyncGeneratorSettle(generator, error, true, true);
+                @asyncGeneratorResumeNext(generator);
+            });
+        return;
+    }
+
+    let kind = generator.@asyncGeneratorYieldKind;
+    if (kind === 1) {
+        // yield: the value is awaited, then handed to the waiting request;
+        // the body stays suspended until the next one.
+        @asyncGeneratorAwaitThen(value,
+            function(result) {
+                generator.@asyncGeneratorRunning = false;
+                @asyncGeneratorSettle(generator, result, false, false);
+                @asyncGeneratorResumeNext(generator);
+            },
+            function(error) {
+                @asyncGeneratorStep(generator, error, @GeneratorResumeModeThrow);
+            });
+        return;
+    }
+
+    if (kind === 2) {
+        // yield*: hand requests to the inner async iterator until it's done.
+        let iterator;
+        try {
+            iterator = @getAsyncIterator(value);
+        } catch (error) {
+            @asyncGeneratorStep(generator, error, @GeneratorResumeModeThrow);
+            return;
+        }
+        generator.@asyncGeneratorDelegate = iterator;
+        @asyncGeneratorResumeDelegate(generator, @undefined, @GeneratorResumeModeNormal);
+        return;
+    }
+
+    // await: resume the body with the result.
+    @asyncGeneratorAwaitThen(value,
+        function(result) { @asyncGeneratorStep(generator, result, @GeneratorResumeModeNormal); },
+        function(error) { @asyncGeneratorStep(generator, error, @GeneratorResumeModeThrow); });
+}
+
+@globalPrivate
+function asyncGeneratorResumeDelegate(generator, sentValue, resumeMode)
+{
+    "use strict";
+
+    let iterator = generator.@asyncGeneratorDelegate;
+    generator.@asyncGeneratorRunning = true;
+
+    let method;
+    if (resumeMode === @GeneratorResumeModeNormal)
+        method = iterator.next;
+    else if (resumeMode === @GeneratorResumeModeThrow)
+        method = iterator.throw;
+    else
+        method = iterator.return;
+
+    if (method === @undefined || method === null) {
+        generator.@asyncGeneratorDelegate = @undefined;
+        if (resumeMode === @GeneratorResumeModeThrow) {
+            let returnMethod = iterator.return;
+            if (returnMethod !== @undefined && returnMethod !== null) {
+                try {
+                    returnMethod.@call(iterator);
+                } catch (error) {
+                }
+            }
+            @asyncGeneratorStep(generator, new @TypeError("The delegated iterator has no throw method"), @GeneratorResumeModeThrow);
+        } else
+            @asyncGeneratorStep(generator, sentValue, resumeMode);
+        return;
+    }
+
+    let promise;
+    try {
+        promise = method.@call(iterator, sentValue);
+    } catch (error) {
+        generator.@asyncGeneratorDelegate = @undefined;
+        @asyncGeneratorStep(generator, error, @GeneratorResumeModeThrow);
+        return;
+    }
+
+    @asyncGeneratorAwaitThen(promise,
+        function(result) {
+            if (!@isObject(result)) {
+                generator.@asyncGeneratorDelegate = @undefined;
+                @asyncGeneratorStep(generator, new @TypeError("Iterator result interface is not an object."), @GeneratorResumeModeThrow);
+                return;
+            }
+            if (result.done) {
+                generator.@asyncGeneratorDelegate = @undefined;
+                @asyncGeneratorStep(generator, result.value, resumeMode === @GeneratorResumeModeReturn ? @GeneratorResumeModeReturn : @GeneratorResumeModeNormal);
+                return;
+            }
+            generator.@asyncGeneratorRunning = false;
+            @asyncGeneratorSettle(generator, result.value, false, false);
+            @asyncGeneratorResumeNext(generator);
+        },
+        function(error) {
+            generator.@asyncGeneratorDelegate = @undefined;
+            @asyncGeneratorStep(generator, error, @GeneratorResumeModeThrow);
+        });
+}
+
+// GetIterator(obj, async): its Symbol.asyncIterator, or its ordinary
+// iterator with each value awaited.
+@globalPrivate
+function getAsyncIterator(iterable)
+{
+    "use strict";
+
+    if (iterable === @undefined || iterable === null)
+        @throwTypeError("Object is not async iterable");
+
+    let method = iterable.@asyncIteratorSymbol;
+    if (method !== @undefined && method !== null) {
+        let iterator = method.@call(iterable);
+        if (!@isObject(iterator))
+            @throwTypeError("The async iterator is not an object");
+        return iterator;
+    }
+
+    method = iterable.@iteratorSymbol;
+    if (typeof method !== "function")
+        @throwTypeError("Object is not async iterable");
+    let syncIterator = method.@call(iterable);
+    if (!@isObject(syncIterator))
+        @throwTypeError("The iterator is not an object");
+    return @createAsyncFromSyncIterator(syncIterator);
+}
+
+@globalPrivate
+function createAsyncFromSyncIterator(syncIterator)
+{
+    "use strict";
+
+    let nextMethod = syncIterator.next;
+
+    function settle(result)
+    {
+        let capability = @newPromiseCapability(@Promise);
+        if (!@isObject(result)) {
+            capability.@reject.@call(@undefined, new @TypeError("Iterator result interface is not an object."));
+            return capability.@promise;
+        }
+        let done = !!result.done;
+        let valueCapability = @newPromiseCapability(@Promise);
+        valueCapability.@resolve.@call(@undefined, result.value);
+        valueCapability.@promise.@then(
+            function(value) { capability.@resolve.@call(@undefined, { value: value, done: done }); },
+            function(error) { capability.@reject.@call(@undefined, error); });
+        return capability.@promise;
+    }
+
+    function rejected(error)
+    {
+        let capability = @newPromiseCapability(@Promise);
+        capability.@reject.@call(@undefined, error);
+        return capability.@promise;
+    }
+
+    let asyncIterator = {
+        next: function(value) {
+            try {
+                return settle(nextMethod.@call(syncIterator, value));
+            } catch (error) {
+                return rejected(error);
+            }
+        },
+        return: function(value) {
+            try {
+                let method = syncIterator.return;
+                if (method === @undefined || method === null)
+                    return settle({ value: value, done: true });
+                return settle(method.@call(syncIterator, value));
+            } catch (error) {
+                return rejected(error);
+            }
+        },
+        throw: function(value) {
+            try {
+                let method = syncIterator.throw;
+                if (method === @undefined || method === null)
+                    return rejected(value);
+                return settle(method.@call(syncIterator, value));
+            } catch (error) {
+                return rejected(error);
+            }
+        }
+    };
+    return asyncIterator;
+}
