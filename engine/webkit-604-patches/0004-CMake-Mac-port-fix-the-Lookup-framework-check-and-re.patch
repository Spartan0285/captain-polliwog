From b196e8f3566303ed0a83b85f4418ff3af4db0854 Mon Sep 17 00:00:00 2001
From: Captain Polliwog build <build@captainpolliwog.invalid>
Date: Thu, 17 Sep 2026 23:53:20 -0400
Subject: [PATCH 04/57] CMake Mac port: fix the Lookup framework check and
 readline's name

"if (NOT LOOKUP_FRAMEWORK-NOTFOUND)" tests a variable that never exists,
so Lookup was always linked; and libreadline is lowercase on a
case-sensitive file system.
---
 Source/WTF/wtf/PlatformMac.cmake | 2 +-
 Source/WebCore/PlatformMac.cmake | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Source/WTF/wtf/PlatformMac.cmake b/Source/WTF/wtf/PlatformMac.cmake
index a607dd04..ae500293 100644
--- a/Source/WTF/wtf/PlatformMac.cmake
+++ b/Source/WTF/wtf/PlatformMac.cmake
@@ -1,6 +1,6 @@
 find_library(COCOA_LIBRARY Cocoa)
 find_library(COREFOUNDATION_LIBRARY CoreFoundation)
-find_library(READLINE_LIBRARY Readline)
+find_library(READLINE_LIBRARY readline)
 list(APPEND WTF_LIBRARIES
     ${COREFOUNDATION_LIBRARY}
     ${COCOA_LIBRARY}
diff --git a/Source/WebCore/PlatformMac.cmake b/Source/WebCore/PlatformMac.cmake
index 8b72ecfe..3262bf23 100644
--- a/Source/WebCore/PlatformMac.cmake
+++ b/Source/WebCore/PlatformMac.cmake
@@ -76,7 +76,7 @@ if (NOT DATADETECTORSCORE_FRAMEWORK-NOTFOUND)
 endif ()
 
 find_library(LOOKUP_FRAMEWORK Lookup HINTS /System/Library/PrivateFrameworks)
-if (NOT LOOKUP_FRAMEWORK-NOTFOUND)
+if (LOOKUP_FRAMEWORK)
     list(APPEND WebCore_LIBRARIES ${LOOKUP_FRAMEWORK})
 endif ()
 
