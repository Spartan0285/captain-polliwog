@@ -181,7 +185,14 @@
     snprintf(buffer.mutableSpan().data(), length, "%s/%s-XXXXXX", directory, prefixUTF8.data());
     IGNORE_CLANG_WARNINGS_END
 
+#if CP_OLD_DARWIN
+    int temporary = mkstemp(buffer.mutableSpan().data());
