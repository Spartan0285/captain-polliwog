-#if !OS(DARWIN) && !OS(FUCHSIA) && OS(UNIX)
+#if (!OS(DARWIN) || CP_OLD_DARWIN) && !OS(FUCHSIA) && OS(UNIX)
 NEVER_INLINE NO_RETURN_DUE_TO_CRASH static void crashUnableToOpenURandom()
 {
     CRASH();
@@ -63,7 +63,7 @@
 }
 #endif
 
-#if !OS(DARWIN) && !OS(FUCHSIA) && !OS(WINDOWS)
+#if (!OS(DARWIN) || CP_OLD_DARWIN) && !OS(FUCHSIA) && !OS(WINDOWS)
 RandomDevice::RandomDevice()
 {
     int ret = 0;
@@ -76,7 +76,7 @@
 }
 #endif
 
-#if !OS(DARWIN) && !OS(FUCHSIA) && !OS(WINDOWS)
+#if (!OS(DARWIN) || CP_OLD_DARWIN) && !OS(FUCHSIA) && !OS(WINDOWS)
 RandomDevice::~RandomDevice()
 {
     close(m_fd);
@@ -87,7 +87,7 @@
 // https://bugs.webkit.org/show_bug.cgi?id=170190
 void RandomDevice::cryptographicallyRandomValues(std::span<uint8_t> buffer)
 {
-#if OS(DARWIN)
+#if OS(DARWIN) && !CP_OLD_DARWIN
