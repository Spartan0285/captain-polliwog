Randomness and memory size on a Mac that predates both ways.

CommonCrypto grew its random generator in 10.8; before that a Mac reads
/dev/urandom, which is the path every other Unix here takes. And Darwin
has never had sysconf(_SC_PHYS_PAGES): the memory size comes from sysctl.

--- a/Source/WTF/wtf/RandomDevice.cpp	2026-09-23 00:23:42
+++ b/Source/WTF/wtf/RandomDevice.cpp	2026-09-23 00:25:27
@@ -29,7 +29,7 @@
 
 #include <stdlib.h>
 
-#if !OS(DARWIN) && !OS(FUCHSIA) && OS(UNIX)
+#if (!OS(DARWIN) || CP_OLD_DARWIN) && !OS(FUCHSIA) && OS(UNIX)
 #include <errno.h>
 #include <fcntl.h>
 #include <unistd.h>
@@ -40,7 +40,7 @@
 #include <wincrypt.h> // windows.h must be included before wincrypt.h.
 #endif
 
-#if OS(DARWIN)
+#if OS(DARWIN) && !CP_OLD_DARWIN
 #include <CommonCrypto/CommonCryptor.h>
 #include <CommonCrypto/CommonRandom.h>
 #endif
@@ -51,7 +51,7 @@
 
