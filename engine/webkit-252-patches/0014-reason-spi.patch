The reason SPI is Apple internal.

The released source does not carry wtf/spi/darwin/ReasonSPI.h, and
abort_with_reason is not on a Mac this old in any case.

--- a/Source/WTF/wtf/Assertions.h	2026-09-23 00:34:38
+++ b/Source/WTF/wtf/Assertions.h	2026-09-23 00:34:38
@@ -51,7 +51,9 @@
 #include <android/log.h>
 #endif
 
-#if OS(DARWIN)
+// abort_with_reason and its header are Apple's own; the released source
+// carries neither, and a Mac this old has no such call.
+#if OS(DARWIN) && !CP_OLD_DARWIN
 #include <wtf/spi/darwin/ReasonSPI.h>
 #endif
 
