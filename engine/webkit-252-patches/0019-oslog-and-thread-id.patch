--- a/Source/JavaScriptCore/runtime/ProfilerSupport.cpp	2026-09-23 01:04:29
+++ b/Source/JavaScriptCore/runtime/ProfilerSupport.cpp	2026-09-23 01:04:29
@@ -100,9 +100,15 @@
 #elif OS(DARWIN)
     // Ideally we would like to use pthread_threadid_np. But this is 64bit, while required one is 32bit.
     // For now, as a workaround, we only report lower 32bit of thread ID.
+#if CP_OLD_DARWIN
+    // pthread_threadid_np is 10.6. The mach port of the thread is the same
+    // kind of identifier, and is already 32-bit.
+    return static_cast<uint32_t>(pthread_mach_thread_np(pthread_self()));
+#else
     uint64_t thread = 0;
     pthread_threadid_np(NULL, &thread);
     return static_cast<uint32_t>(thread);
+#endif
 #elif OS(WINDOWS)
     return static_cast<uint32_t>(GetCurrentThreadId());
 #else
